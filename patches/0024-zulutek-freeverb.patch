+static inline float rv_side(float in, int ch)
+{
+    int c0 = ch ? R_CR : R_CL, a0 = ch ? R_AR : R_AL, k;
+    float y = 0.0f;
+    for (k = 0; k < RV_COMBS; k++) {
+        int c = c0 + k;
+        float d = rtap(c, r_len[c]);              /* the oldest sample in the comb */
+        rv.fs[ch][k] += rv.damp * (d - rv.fs[ch][k]);
+        rput(c, in + rv.fs[ch][k] * rv.decay);
+        y += d;
