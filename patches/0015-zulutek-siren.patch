diff --git a/atek303/app/ztek_siren.c b/atek303/app/ztek_siren.c
new file mode 100644
index 0000000..dae799b
--- /dev/null
+++ b/atek303/app/ztek_siren.c
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_siren.c — voir ztek_siren.h. Sirène 4 types, oscillateur à phase + balayage de hauteur,
+ * mixée pre-FX (le bus mono part dans fx_process, comme la chaîne APK : … → siren → fx → out). */
+#include <math.h>
+#include <string.h>
+#include "ztek_siren.h"
+
+const char *const ZSIR_NAMES[ZSIR_NW] = { "CLASSIQUE", "CHOP", "POLICE", "LASER" };
+
+static float  sr;
+static uint8_t par[4];                 /* WAVE, RATE, DEPTH, MIX — 0..255, persistés en OBJ_OPTIONS */
+static int    mode, gate;
+static float  phase, t;                /* phase osc, temps depuis le trig (s) */
+
+void zsir_init(float s)
+{
+    sr = s;
+    memset(par, 0, sizeof par);
+    par[1] = 128; par[2] = 128; par[3] = 160;   /* RATE/DEPTH milieux, MIX ~0.63 */
+    mode = 0; gate = 0; phase = 0.0f; t = 0.0f;
+}
+
+uint8_t zsir_get(int k) { return (k >= 0 && k < 4) ? par[k] : 0; }
+void zsir_set(int k, uint8_t v) { if (k >= 0 && k < 4) par[k] = v; }
+
+int  zsir_mode(void) { return mode; }
+void zsir_mode_set(int on) { mode = on ? 1 : 0; if (!mode) gate = 0; }
+
+void zsir_trig(int wave)
+{
+    if (!mode) return;
+    if (wave < 0 || wave >= ZSIR_NW) wave = 0;
+    par[0] = (uint8_t)wave;
+    gate = 1;
+    phase = 0.0f;
+    t = 0.0f;
+}
+
+void zsir_off(void) { gate = 0; }
+
+void zsir_encoder(int k, int32_t det)   /* k 0..3, pas de wrap (comme opt_change) */
+{
+    int32_t v;
+    if (k < 0 || k >= 4) return;
+    v = par[k] + (det > 0 ? 1 : -1);
+    if (v < 0) return;
+    if (k == 0) { if (v >= ZSIR_NW) return; }
+    else if (v > 255) return;
+    par[k] = (uint8_t)v;
+}
+
+/* fréquence courante (Hz) à l'instant t pour le type demandé */
+static float zsir_freq(int wave, float rate, float depth, float t)
+{
+    float f0 = 440.0f;
+    switch (wave) {
+    case 1:                                     /* CHOP : carré fixe, gate carré rapide */
+        return 330.0f;
+    case 2: {                                   /* POLICE : deux tons alternés */
+        float p = 1.0f / (0.5f + 3.0f * rate);
+        float ph = fmodf(t, p);
+        return ph < p * 0.5f ? 392.0f : 523.0f;
+    }
+    case 3: {                                   /* LASER : dent de scie descendante */
+        float f = f0 * 2.0f * expf(-(2.0f + 6.0f * rate) * t);
+        return f < 55.0f ? 55.0f : f;
+    }
+    default:                                    /* CLASSIQUE : balayage sinusoïdal lent */
+        return f0 * (1.0f + 0.6f * depth * sinf(6.2831853f * (0.5f + 4.0f * rate) * t));
+    }
+}
+
+void zsir_render(float *mono, uint32_t n)
+{
+    uint32_t i;
+    float rate, depth, mix, amp;
+    int wave, chop_on;
+    if (!mode || !gate || !mono) return;
+    wave = par[0];
+    rate = par[1] / 255.0f;
+    depth = par[2] / 255.0f;
+    mix = par[3] / 255.0f;
+    if (mix <= 0.0f) return;
+    amp = mix * 0.4f;
+    for (i = 0; i < n; i++) {
+        float f = zsir_freq(wave, rate, depth, t);
+        float s;
+        phase += 6.2831853f * f / sr;
+        if (phase > 6.2831853f * 64.0f) phase = fmodf(phase, 6.2831853f);
+        switch (wave) {
+        case 1:  chop_on = sinf(6.2831853f * (1.0f + 6.0f * rate) * t) > 0.0f;
+                 s = chop_on ? (sinf(phase) >= 0.0f ? 1.0f : -1.0f) : 0.0f;
+                 break;
+        case 3:  s = 2.0f * (phase / 6.2831853f) - 1.0f;   /* dent de scie */
+                 break;
+        case 2:  s = sinf(phase) >= 0.0f ? 0.8f : -0.8f;    /* carré doux deux tons */
+                 break;
+        default: s = sinf(phase);
+        }
+        mono[i] += s * amp;
+        t += 1.0f / sr;
+    }
+}
