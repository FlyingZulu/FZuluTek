+void    zlk_siren_set(int k, int32_t v)
+{
+    if (v < 0) v = 0;
+    if (k == 0) { if (v > 3) v = 3; zsir_opt_set(0, (int)v); }   /* wave 0..3 */
+    else { if (v > 1000) v = 1000; zsir_opt_set(k, (int)(v * 255 / 1000)); }
+}
