+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_siren: la sirène du FM-1 (patch 0015) — parité APK (triple-tap GLO = mode SIREN,
+ * noires k=13/15/17/20 = 4 types momentanés, K1..K4 = WAVE/RATE/DEPTH/MIX).
+ * C99, pas d'allocation dynamique. */
+#pragma once
+#include <stdint.h>
+
+#define ZSIR_NW 4
+extern const char *const ZSIR_NAMES[ZSIR_NW];   /* CLASSIQUE / CHOP / POLICE / LASER */
+
+void    zsir_init(float sr);
+void    zsir_render(float *mono, uint32_t n);   /* accumule la sirène dans le bus mono (pre-FX, comme la chaîne APK) */
+void    zsir_trig(int wave);                     /* démarre la sirène (gate on), wave 0..3 */
+void    zsir_off(void);                          /* gate off (touche relâchée) */
+int     zsir_mode(void);                         /* mode SIREN actif */
+void    zsir_mode_set(int on);
+void    zsir_encoder(int k, int32_t det);        /* en mode SIREN : k 0..3 = WAVE / RATE / DEPTH / MIX */
+uint8_t zsir_get(int k);                         /* param k en 0..255 */
+void    zsir_set(int k, uint8_t v);              /* param k en 0..255 */
