+int  zsir_opt_get(int idx) { return idx >= 0 && idx < 4 ? opt.v[OP_SIREN_WAVE + idx] : 0; }
+void zsir_opt_set(int idx, int v)
+{
+    static uint32_t last_save;
+    if (idx < 0 || idx >= 4)
+        return;
+    opt.v[OP_SIREN_WAVE + idx] = (uint8_t)v;
+    zsir_set(idx, (uint8_t)v);
+    ui.opt_dirty = 1;
+    if (plat_ms() - last_save > 1000u) {
+        last_save = plat_ms();
+        if (plat_store_save(OBJ_OPTIONS, &opt, sizeof opt) != 0)
+            app_say("OPTIONS", "NOT SAVED");
+    }
+}
