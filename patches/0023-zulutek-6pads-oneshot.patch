 } ui;
 
 /* ---- ztek_seqplus accessors (patch 0005) ---- */
@@ -1695,6 +1696,19 @@
 }
 /* in the list, SEL or a white key: the preset loads at once (running too, without waiting for the pattern's end) */
 static const uint8_t WHITE_KEY[16] = PLAT_WHITE_KEYS;
+
+/* patch 0023: SHIFT FM-1 = la dernière touche noire du clavier (mode d'emploi), maintenue.
+ * Hors mode clavier (pages DRUM 11 / LOOP 12 pour l'instant) : +SEQ = toggle one-shot. */
+static int zshift_key(void)
+{
+    int k, w, last = -1;
+    for (k = 0; k < NKEYS; k++) {
+        int isw = 0;
+        for (w = 0; w < 16; w++) if (WHITE_KEY[w] == (uint8_t)k) { isw = 1; break; }
+        if (!isw) last = k;
+    }
+    return last;
+}
 static int list_half(void) { return ui.list_cur >= 16 ? 16 : 0; }   /* the white keys: presets 1..16 or 17..32 */
 static void preset_load_now(int c)
 {
@@ -1926,6 +1940,10 @@
     }
     touch_poll();
     keys = touch_keys();
+    {   /* patch 0023: SHIFT FM-1 — dernière noire maintenue = modificateur (pages DRUM/LOOP : +SEQ = one-shot) */
+        int sk = zshift_key();
+        ui.zshift = (sk >= 0 && (set.page == 11u || set.page == 12u) && (keys & (1u << sk))) ? 1 : 0;
+    }
     for (k = 0; k < NKEYS; k++) {
         uint32_t bit = 1u << k;
         int32_t note = 53 + (int32_t)k + 12 * set.octave;
@@ -2074,7 +2092,7 @@
             else if (k == B_LFO) zdr_act_mode();
             else if (k == B_EDIT) zdr_act_kit();
             else if (k == B_SAVE) zdr_act_comp();
-            else if (k == B_SEQ) zdr_act_rand();
+            else if (k == B_SEQ) { if (ui.zshift) zdr_set_oneshot(!zdr_get_oneshot()); else zdr_act_rand(); }   /* patch 0023: SHIFT+SEQ = one-shot */
             else if (k == B_ARP) zdr_act_clear();
             ui.redraw = 1;
             continue;
@@ -2090,7 +2108,7 @@
             else if (k == B_ENV) zml_act_od();
             else if (k == B_LFO) zml_act_erase();
             else if (k == B_EDIT) zml_act_rs();
-            else if (k == B_SEQ) zml_act_mutate();
+            else if (k == B_SEQ) { if (ui.zshift) zml_set_oneshot(!zml_get_oneshot()); else zml_act_mutate(); }   /* patch 0023: SHIFT+SEQ = one-shot */
             else if (k == B_ARP) zml_act_rand();
             ui.redraw = 1;
             continue;

