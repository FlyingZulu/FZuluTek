+/* ---- patch 0012: accesseurs pour ztek_fine.c (page FINE 14) ---- */
+void app_say(const char *a, const char *b);   /* app.h (app.c ne l'inclut pas: prototype local) */
+int  zf_opt_get(int idx) { return idx >= 0 && idx < ZFINE_NOPT ? opt.v[OP_FINE + idx] : 0; }
+void zf_opt_set(int idx, int v)
+{
+    static uint32_t last_save;
+    if (idx < 0 || idx >= ZFINE_NOPT)
+        return;
+    opt.v[OP_FINE + idx] = (uint8_t)v;
+    ui.opt_dirty = 1;
+    post(EV_OPTION, (uint32_t)idx, (uint32_t)v);
+    if (plat_ms() - last_save > 1000u) {      /* flash: pas à chaque cran */
+        last_save = plat_ms();
+        if (plat_store_save(OBJ_OPTIONS, &opt, sizeof opt) != 0)
+            app_say("OPTIONS", "NOT SAVED");
+    }
+}
+const char *zf_opt_value(int idx, int v)
+{
+    static char t[24];
+    fine_value_text(idx, v, t);
+    return t;
+}
+void zf_say(const char *a, const char *b) { app_say(a, b); }
