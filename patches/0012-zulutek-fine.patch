 {
     int32_t k, len = seq_len(), on = view_base() / 16;
@@ -2464,7 +2537,9 @@ static void draw(void)
         return;
     }
     cv_begin(240, 138, C_BLACK);               /* 32 .. 170: no gap under the header */
-    for (i = 0; i < 4; i++) {
+    if (set.page == ZFINE_PAGE)                /* patch 0012: page FINE — 4 colonnes façon Shruthi */
+        zfine_draw();
+    else for (i = 0; i < 4; i++) {
         int kn = PAGE_KNOB[set.page][i];
         int32_t x = (i & 1) * 120, y = (i >> 1) * 68 + 2, w;
         if (kn == K_NONE)
@@ -2535,6 +2610,36 @@ void app_ui_init(void)
     ui.redraw = 1;
 }
 
+/* patch 0012: page FINE — 4 colonnes, une par knob du banc courant (SEL = banc) */
+static void zfine_draw(void)
+{
+    char t[24], n[4];
+    int b = zfine_bank(), i;
+    t[0] = 0;
+    text_cat(t, "FINE ");
+    int_text(b + 1, n);
+    text_cat(t, n);
+    text_cat(t, "/3 ");
+    text_cat(t, ZFINE_BANK_NAME[b]);
+    cv_text(120 - text_w(&FONT_B, t) / 2, 4, &FONT_B, t, C_WHITE);
+    cv_text(120 + text_w(&FONT_B, t) / 2 + 8, 6, &FONT_XS, "<SEL>", C_GRAY);
+    for (i = 0; i < 4; i++) {
+        int idx = ZFINE_BANK_OPT[b][i];
+        int v = zf_opt_get(idx);
+        int mx = idx == ZFINE_OPT_MODEL ? 1 : idx == ZFINE_OPT_MORPH ? 255 : AT_OPT_N[idx] - 1;
+        int32_t cx = i * 60, w;
+        cv_text(cx + 4, 26, &FONT_XS, ZFINE_KN[b][i], C_GRAY);
+        cv_text(cx + 4, 42, &FONT_B, zf_opt_value(idx, v), C_HI);
+        cv_rect(cx + 4, 68, 52, 6, C_LINE);
+        w = mx > 0 ? (int32_t)(52.0f * v / (float)mx + 0.5f) : 52;
+        cv_rect(cx + 4, 68, w, 6, C_LOGO);
+        n[0] = 'K';
+        n[1] = (char)('1' + i);
+        n[2] = 0;
+        cv_text(cx + 4, 82, &FONT_XS, n, C_GRAY);
+    }
+}
