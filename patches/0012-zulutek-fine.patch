+int  zf_opt_get(int idx);                 /* idx 0..ZFINE_NOPT-1 -> opt.v[OP_FINE+idx] */
+void zf_opt_set(int idx, int v);          /* opt.v + EV_OPTION + save OBJ_OPTIONS (throttlé) */
+const char *zf_opt_value(int idx, int v); /* nom de la valeur (table FINE / MODEL / MORPH) */
+void zf_say(const char *a, const char *b);
