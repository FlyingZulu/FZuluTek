+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * patch 0012: page FINE — voir ztek_fine.h. Logique seule ici (pas de gfx) : le dessin est
+ * zfine_draw() dans app.c. Les options sont des choix discrets (AT_OPT_N[idx] valeurs), sauf
+ * le morph LP->HP continu 0..255. Un cran d'encodeur = un pas (comme le menu OPTIONS).
+ */
+#include "ztek_fine.h"
+#include "app.h"                 /* plat.h (fm1-base) : EN_SELECT, EN_K1..EN_K4 */
+
+const char *const ZFINE_BANK_NAME[ZFINE_NBANK] = {"OSC", "FILTRE", "AMP"};
+const char *const ZFINE_KN[ZFINE_NBANK][4] = {
+    {"PW", "SQ DRP", "SAW RS", "SAW DRP"},
+    {"MODEL", "MORPH", "DRIVE", "OTA"},
+    {"SLIDE", "LEGATO", "SAT", "DRIFT"},
+};
+/* banc 0 OSC : PW / SQ_DROOP / SAW_RESET / SAW_DROOP
+ * banc 1 FILTRE : modèle ORG/NEW / morph LP->HP / DRIVE / OTA
+ * banc 2 AMP : SLIDE tau / LEGATO / SAT out / DRIFT */
+const int ZFINE_BANK_OPT[ZFINE_NBANK][4] = {
+    {AT_OPT_PW, AT_OPT_SQ_DROOP, AT_OPT_SAW_RESET, AT_OPT_SAW_DROOP},
+    {ZFINE_OPT_MODEL, ZFINE_OPT_MORPH, AT_OPT_DRIVE, AT_OPT_OTA},
+    {AT_OPT_SLIDE, AT_OPT_LEGATO, AT_OPT_SAT, AT_OPT_DRIFT},
+};
+
+static int bank;
+
+int zfine_bank(void) { return bank; }
+
+static int opt_max(int idx)               /* nb de valeurs - 1 */
+{
+    if (idx == ZFINE_OPT_MODEL)
+        return 1;
+    if (idx == ZFINE_OPT_MORPH)
+        return 255;
+    return AT_OPT_N[idx] - 1;
+}
+
+void zfine_encoder(int k, int32_t det)
+{
+    if (k == EN_SELECT) {                 /* SEL = banc (Shruthi : la "page" interne) */
+        int b = bank + (det > 0 ? 1 : -1);
+        bank = (b % ZFINE_NBANK + ZFINE_NBANK) % ZFINE_NBANK;
+        zf_say("FINE", ZFINE_BANK_NAME[bank]);
+        return;
+    }
+    if (k >= EN_K1 && k <= EN_K4) {
+        int i = k - EN_K1;
+        int idx = ZFINE_BANK_OPT[bank][i];
+        int v = zf_opt_get(idx) + (det > 0 ? 1 : -1);
+        int mx = opt_max(idx);
+        if (v < 0)
+            v = 0;
+        if (v > mx)
+            v = mx;
+        if (v == zf_opt_get(idx))
+            return;
+        zf_opt_set(idx, v);
+        zf_say(ZFINE_KN[bank][i], zf_opt_value(idx, v));
+    }
+}
