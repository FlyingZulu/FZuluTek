             char t[24];
             knob_turn(AT_WAVE, e > 0 ? 1 : -1);
@@ -2104,6 +2176,7 @@ static int32_t view_base(void)
     int32_t s = ui.edit ? ui.cursor : sq.running ? sq.step : 0;
