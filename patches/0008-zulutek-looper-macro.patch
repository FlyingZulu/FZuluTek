@@ -0,0 +1,9 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * patch 0008: dsp/midi_looper.c compilé pour le FM-1 avec un ring resample réduit
+ * (ML_RS_MAX 4096 ~ 8 Ko au lieu de 16384 ~ 32 Ko) — même principe que ztek_drum_fm1.c
+ * (DR_FM1_ECO). ztek_loop.c définit le même ML_RS_MAX avant d'inclure midi_looper.h,
+ * pour que sizeof(ml_t) soit identique dans les deux unités de compilation. */
