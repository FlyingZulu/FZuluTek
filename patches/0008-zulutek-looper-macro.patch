diff --git a/atek303/app/ztek_macro.c b/atek303/app/ztek_macro.c
new file mode 100644
index 0000000..34a571d
--- /dev/null
+++ b/atek303/app/ztek_macro.c
@@ -0,0 +1,128 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_macro.c — glue FM-1 des macros (voir ztek_macro.h). C99, pas d'allocation dynamique.
+ * L'application d'une cible passe par les accesseurs du pack SEQ+ (zsp_*), du drum
+ * (zdr_mod_set) et du looper (zml_gain), définis dans leurs modules / app.c. */
+#include <string.h>
+#include "ztek_macro.h"
+#include "ztek_drum.h"
+#include "ztek_loop.h"
+
+typedef struct { int dst; float val; int used; } zmac_slot_t;
+
+static zmac_slot_t mac[ZMAC_N];
+static int sel;
+static float pv[7];                      /* 0 SEL 1 ALGO(dst) 3 K1(niveau) */
+
+static float clamp01(float v) { return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v; }
+
+static void say2(const char *a, int slot)
+{
+    char t[8];
+    t[0] = 'M';
+    t[1] = (char)('0' + (slot + 1) / 10);
+    t[2] = (char)('0' + (slot + 1) % 10);
+    t[3] = 0;
+    zmac_say(a, t);
+}
+
+/* applique une cible <- niveau (même mapping que la matrice ASSIGN, patch 0005/0008) */
+static void apply_dst(int dst, float val)
+{
+    if (dst < 0 || dst >= ZMAC_NDST) return;
+    val = clamp01(val);
+    if (dst < AT_NPARAMS)
+        zsp_at_set(dst, val);
+    else if (dst < ZSP_SEQ_DST0)
+        zsp_fx_set(dst - AT_NPARAMS, val);
+    else if (dst < ZSP_DST_DRUM0) {
+        int k = dst - ZSP_SEQ_DST0;
+        if (k == 1) zsp_set_scale((int)(val * 7.99f));
+        else if (k == 2) zsp_set_tempo((int)(val * 300.0f));
+        else if (k == 3) zsp_set_root(24 + (int)(val * 48.99f));
+        else zsp_set_seqk(k - 4, val);
+    }
+    else if (dst < ZSP_NDST)
+        zdr_mod_set(dst - ZSP_DST_DRUM0, val);
+    else
+        zml_gain(val);                   /* ZMAC_DST_LOOP */
+}
+
+void zmac_init(void)
+{
+    memset(mac, 0, sizeof mac);
+    sel = 0;
+    memset(pv, 0, sizeof pv);
+}
+
+void zmac_store(void)
+{
+    mac[sel].dst = (int)(clamp01(pv[1]) * (ZMAC_NDST - 0.001f));
+    mac[sel].val = clamp01(pv[3]);
+    mac[sel].used = 1;
+    say2("STORED", sel);
+}
+
+void zmac_apply(void)
+{
+    if (!mac[sel].used) { say2("EMPTY", sel); return; }
+    apply_dst(mac[sel].dst, mac[sel].val);
+    say2("APPLY", sel);
+}
+
+void zmac_apply_all(void)
+{
+    int m, n = 0;
+    for (m = 0; m < ZMAC_N; m++)
+        if (mac[m].used) { apply_dst(mac[m].dst, mac[m].val); n++; }
+    zmac_say("APPLY ALL", n ? "OK" : "NONE");
+}
+
+void zmac_erase(void)
+{
+    mac[sel].used = 0;
+    mac[sel].dst = 0;
+    mac[sel].val = 0.0f;
+    say2("ERASED", sel);
+}
+
+void zmac_slot(int slot)
+{
+    if (slot < 0 || slot >= ZMAC_N) return;
+    sel = slot;
+    if (mac[sel].used)
+        apply_dst(mac[sel].dst, mac[sel].val);
+    say2(mac[sel].used ? "APPLY" : "SLOT", sel);
+}
+
+void zmac_step(int d)
+{
+    sel = (sel + d + ZMAC_N) % ZMAC_N;
+    say2("SLOT", sel);
+}
+
+/* enc = 0 SELECT 1 ALGO 2 PRESET 3..6 K1..K4 (ordre enum) */
+void zmac_encoder(int enc, int32_t det)
+{
+    float v;
+    if (det == 0) return;
+    if (enc == 0) {                      /* SELECT = slot */
+        pv[0] = clamp01(pv[0] + (float)det * 0.02f);
+        sel = (int)(pv[0] * (ZMAC_N - 0.001f));
+        if (sel >= ZMAC_N) sel = ZMAC_N - 1;
+        say2("SLOT", sel);
+    } else if (enc == 1) {               /* ALGO = dst (pas fin : 50 positions pour 44 dst) */
+        pv[1] = clamp01(pv[1] + (float)det * 0.02f);
+        zmac_say("DST", "");
+    } else if (enc == 3) {               /* K1 = niveau */
+        pv[3] = clamp01(pv[3] + (float)det * 0.05f);
+        zmac_say("LEVEL", "");
+    }
+    (void)v;
+}
+
+int   zmac_sel(void) { return sel; }
+int   zmac_used(int slot) { return (slot >= 0 && slot < ZMAC_N) ? mac[slot].used : 0; }
+int   zmac_dst(int slot) { return (slot >= 0 && slot < ZMAC_N) ? mac[slot].dst : 0; }
+float zmac_val(int slot) { return (slot >= 0 && slot < ZMAC_N) ? mac[slot].val : 0.0f; }
diff --git a/atek303/app/ztek_macro.h b/atek303/app/ztek_macro.h
new file mode 100644
index 0000000..ac32fc8
--- /dev/null
+++ b/atek303/app/ztek_macro.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_macro: les macros zuluTek sur le FM-1 (patch 0008) — page MACRO (13).
+ *
+ * Un macro = un conteneur assignable : cible (dst) + niveau 0..1, PAS un séquenceur
+ * d'actions (même sémantique que l'APK, PR #3 page 14). 16 slots.
+ *
+ * Cibles (dst), même espace que la matrice ASSIGN du pack SEQ+ (patch 0005) + drum (0008) :
+ *   0..AT_NPARAMS-1        params voix (zsp_at_set)
+ *   AT_NPARAMS..           params FX (zsp_fx_set)
+ *   ZSP_SEQ_DST0..         seq (scale/tempo/root/seqk, comme la matrice)
+ *   ZSP_DST_DRUM0..        bus drum (zdr_mod_set : MASTER/SWING/COMP/…)
+ *   ZMAC_DST_LOOP          loop_gain (niveau de retour des loops MIDI)
+ *
+ * Layout page MACRO (13) :
+ *   - 16 touches blanches = les 16 slots (tap = sélectionne, et applique si utilisé)
+ *   - encodeurs : SELECT = slot, PRESET = preset (global), ALGO = dst par pas de 8,
+ *                 K1 = niveau 0..1, K2..K4 libres
+ *   - boutons : REC = store (sélection courante -> slot SEL), PLAY = applique le slot SEL,
+ *               SEQ = applique tous les slots utilisés, EDIT = efface le slot SEL,
+ *               ENV = slot -1, LFO = slot +1, GLO = quitte la page
+ *   - REC maintenu + SEQ = page MACRO (13)
+ *
+ * Les macros vivent en RAM (pas en flash) en v1. */
+#pragma once
+#include <stdint.h>
+#include "ztek_seqplus.h"
+
+#define ZMAC_N 16
+#define ZMAC_DST_LOOP ZSP_NDST              /* +0 = loop_gain */
+#define ZMAC_NDST (ZSP_NDST + 1)
+
+/* ---- fourni par app.c (patch 0008) ---- */
+void zmac_say(const char *a, const char *b);
+
+/* ---- le module ---- */
+void  zmac_init(void);
+void  zmac_store(void);                  /* REC : sélection courante -> slot SEL */
+void  zmac_apply(void);                  /* PLAY : applique le slot SEL */
+void  zmac_apply_all(void);              /* SEQ */
+void  zmac_erase(void);                  /* EDIT : efface le slot SEL */
+void  zmac_slot(int slot);               /* touche blanche : sélectionne (+ applique si utilisé) */
+void  zmac_step(int d);                  /* ENV/LFO : slot +/- 1 */
+void  zmac_encoder(int enc, int32_t det);/* enc = 0 SEL 1 ALGO 2 PRESET 3..6 K1..K4 */
+int   zmac_sel(void);
+int   zmac_used(int slot);
+int   zmac_dst(int slot);
+float zmac_val(int slot);
