diff --git a/atek303/app/ztek_loop.c b/atek303/app/ztek_loop.c
new file mode 100644
index 0000000..0c028fa
--- /dev/null
+++ b/atek303/app/ztek_loop.c
@@ -0,0 +1,181 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_loop.c — glue FM-1 du MIDI looper (voir ztek_loop.h). C99, pas d'allocation dynamique.
+ * Le moteur lui-même est dsp/midi_looper.c, compilé pour le FM-1 via ztek_loop_fm1.c avec un
+ * ring resample réduit (ML_RS_MAX 4096, ~8 Ko au lieu de 32 Ko) — même macro que DR_FM1_ECO. */
+#include <string.h>
+#include "ztek_loop.h"
+
+#define ML_RS_MAX 4096                   /* doit matcher ztek_loop_fm1.c (taille de ml_t) */
+#include "dsp/midi_looper.h"
+
+static ml_t ml;
+static float busL[ZML_BUS_MAX], busR[ZML_BUS_MAX];
+static float pv[7];                      /* page: 0 SEL(slot) 1 ALGO(src) 2 PRESET(len) 3..6 K1..K4 */
+static int od, mut_layer;
+
+static float clamp01(float v) { return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v; }
+
+static void say_slot(const char *a, int slot, const char *b)
+{
+    char t[8];
+    t[0] = 'L';
+    t[1] = (char)('0' + (slot + 1) / 10);
+    t[2] = (char)('0' + (slot + 1) % 10);
+    t[3] = 0;
+    zml_say(a, t);
+    (void)b;
+}
+
+/* callbacks ml (thread audio) -> app.c */
+static void cb_note_on(void *ctx, int slot, int note, int vel)
+{ (void)ctx; (void)slot; zml_gate(1, note, vel >= 100 ? 1 : 0, 0); }
+static void cb_note_off(void *ctx, int slot, int note)
+{ (void)ctx; (void)slot; zml_gate(0, note, 0, 0); }
+static void cb_param(void *ctx, int slot, int key, float v)
+{ (void)ctx; (void)slot; zml_param(key, v); }
+
+void zml_init(float sr)
+{
+    int i;
+    ml_init(&ml, sr);
+    ml_set_cb(&ml, NULL, cb_note_on, cb_note_off, cb_param);
+    ml_set_bpm(&ml, (float)zml_tempo());
+    ml.loop_gain = 0.8f;
+    ml.playing = zml_playing();
+    for (i = 0; i < ML_NSLOTS; i++) ml.slot[i].sp.src = 3;   /* source REC = ALL par défaut (la voix FM-1 = classe synth) */
+    for (i = 0; i < 7; i++) pv[i] = 0.0f;
+    pv[2] = 0.0f;                        /* len 0 = auto */
+    od = 0;
+    mut_layer = 1;
+    ml_set_randp(&ml, 0.0f);
+}
+
+void zml_render(uint32_t n, const float *in)
+{
+    uint32_t i;
+    if (n > ZML_BUS_MAX) n = ZML_BUS_MAX;
+    ml_set_bpm(&ml, (float)zml_tempo());
+    if (ml.rs_rec && in)
+        ml_rs_feed(&ml, in, n);
+    ml_render(&ml, n);
+    for (i = 0; i < n; i++) { busL[i] = 0.0f; busR[i] = 0.0f; }
+    ml_rs_render(&ml, busL, busR, n);
+}
+
+const float *zml_bus_l(void) { return busL; }
+const float *zml_bus_r(void) { return busR; }
+
+void zml_note_in(int note, int vel) { ml_note_in(&ml, note, vel, 4, 1); }   /* classe 1 = synth */
+void zml_note_off_in(int note) { ml_note_off_in(&ml, note); }
+void zml_par_in(int key, float v) { ml_par_in(&ml, key, v, 1); }
+void zml_play_sync(void) { ml_play(&ml, zml_playing()); }
+
+void zml_slot_toggle(int slot)
+{
+    if (slot < 0 || slot >= ML_NSLOTS) return;
+    ml_toggle(&ml, slot);
+    say_slot(ml.slot[slot].on ? "ON" : "OFF", slot, "");
+}
+
+/* enc: 0 SELECT 1 ALGO 2 PRESET 3..6 K1..K4 (ordre enum) */
+void zml_encoder(int enc, int32_t det)
+{
+    int slot;
+    float v;
+    if (det == 0) return;
+    slot = (int)(clamp01(pv[0]) * 15.99f);
+    if (slot >= ML_NSLOTS) slot = ML_NSLOTS - 1;
+    ml.sel = slot;
+    if (enc == 0) {                      /* SELECT = slot */
+        pv[0] = clamp01(pv[0] + (float)det * 0.02f);
+        slot = (int)(pv[0] * 15.99f);
+        ml.sel = slot;
+        say_slot("SLOT", slot, "");
+    } else if (enc == 2) {               /* PRESET = longueur 0..2048 (0 = auto) */
+        pv[2] = clamp01(pv[2] + (float)det * 0.02f);
+        ml_set_len(&ml, slot, (int)(pv[2] * 2048.99f));
+        zml_say("LEN", pv[2] < 0.001f ? "AUTO" : "SET");
+    } else if (enc == 1) {               /* ALGO = source REC */
+        pv[1] = clamp01(pv[1] + (float)det * 0.05f);
+        ml_set_sp(&ml, slot, ML_SP_SRC, pv[1] * 6.99f);
+        zml_say("SRC", "");
+    } else if (enc >= 3 && enc <= 6) {    /* K1..K4 = PITCH / POS / MODE / MUT */
+        int k = enc - 3;
+        pv[3 + k] = clamp01(pv[3 + k] + (float)det * 0.05f);
+        v = pv[3 + k];
+        if (k == 0) ml_set_sp(&ml, slot, ML_SP_PITCH, v * 24.0f - 12.0f);
+        else if (k == 1) ml_set_sp(&ml, slot, ML_SP_POS, v * 2047.0f);
+        else if (k == 2) ml_set_sp(&ml, slot, ML_SP_MODE, v * 3.99f);
+        else ml_set_sp(&ml, slot, ML_SP_MUT, v);
+        zml_say(k == 0 ? "PITCH" : k == 1 ? "POS" : k == 2 ? "MODE" : "MUT", "");
+    }
+}
+
+void zml_act_play(void)
+{
+    ml_play(&ml, !ml.playing);
+    zml_say("LOOP", ml.playing ? "PLAY" : "STOP");
+}
+
+void zml_act_rec(void)
+{
+    int i, rec = -1;
+    if (ml.rs_rec) { ml_rs_stop(&ml); zml_say("RESAMPLE", "STOP"); return; }
+    for (i = 0; i < ML_NSLOTS; i++)
+        if (ml.slot[i].rec) { rec = i; break; }
+    if (rec >= 0) {
+        ml_rec_stop(&ml, rec);
+        say_slot("REC STOP", rec, "");
+    } else {
+        ml_rec_start(&ml, ml.sel, od);
+        say_slot(od ? "REC OD" : "REC NEW", ml.sel, "");
+    }
+}
+
+void zml_act_od(void)
+{
+    od = !od;
+    zml_say("OVERDUB", od ? "ON" : "OFF");
+}
+
+void zml_act_erase(void)
+{
+    ml_erase(&ml, ml.sel);
+    say_slot("ERASED", ml.sel, "");
+}
+
+void zml_act_rs(void)
+{
+    if (ml.rs_rec) { ml_rs_stop(&ml); zml_say("RESAMPLE", "STOP"); return; }
+    {
+        uint16_t mm = 0;
+        int i;
+        for (i = 0; i < ML_NSLOTS; i++)
+            if (ml.slot[i].on) mm |= (uint16_t)(1u << i);
+        ml_rs_start(&ml, ml.sel, mm, ML_RS_MAX, 1, 32);   /* µ-law, ring 32 kHz */
+        say_slot("RESAMPLE", ml.sel, "");
+    }
+}
+
+void zml_act_mutate(void)
+{
+    static const char *const LN[4] = {"-", "TIME", "PITCH", "ARTIC"};
+    mut_layer = mut_layer % 3 + 1;
+    ml_mutate(&ml, ml.sel, mut_layer);
+    say_slot("MUTATE", ml.sel, LN[mut_layer]);
+}
+
+void zml_act_rand(void)
+{
+    float p = ml.randp;
+    p = p >= 0.99f ? 0.0f : p + 0.25f;
+    ml_set_randp(&ml, p);
+    zml_say("RAND", p < 0.01f ? "0%" : p < 0.4f ? "25%" : p < 0.7f ? "50%" : "100%");
+}
+
+int zml_sel(void) { return ml.sel; }
+
+void zml_gain(float g) { ml.loop_gain = clamp01(g); }
+float zml_gain_get(void) { return ml.loop_gain; }
diff --git a/atek303/app/ztek_loop.h b/atek303/app/ztek_loop.h
new file mode 100644
index 0000000..2783555
--- /dev/null
+++ b/atek303/app/ztek_loop.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_loop: le MIDI looper zuluTek (dsp/midi_looper.c, pack SEQ+ de la PR #3) piloté depuis
+ * le FM-1 — page LOOP (patch 0008).
+ *
+ * Layout page LOOP (12) :
+ *   - 16 touches blanches = les 16 slots (tap = play/stop du slot, ml_toggle)
+ *   - encodeurs : SELECT = slot, ALGO = source REC (ml_sp.src), PRESET = longueur
+ *                 (0 = auto quantizée à l'arrêt de REC), K1..K4 = PITCH / POS / MODE / MUT du slot
+ *   - boutons : PLAY = transport du looper, REC = REC (start sur le slot SEL; re-REC = stop;
+ *               si un resample tourne: stop), ENV = overdub on/off, LFO = efface le slot SEL,
+ *               EDIT = resample (ring audio) start/stop, SEQ = mutate (layer TIME/PITCH/ARTIC),
+ *               ARP = RAND global (randp 0/25/50/100 %), SAVE = volume du slot SEL (via K1? non :
+ *               consommé, voir ci-dessous), GLO = quitte la page
+ *   - REC maintenu + PLAY = page LOOP (12) ; REC maintenu + SEQ = page MACRO (13)
+ *
+ * Le looper enregistre ce qui est joué : EV_NOTE_ON/OFF -> zml_note_in/zml_note_off_in (classe
+ * synth), EV_PARAM -> zml_par_in (automation de params). La lecture se fait par ml_render :
+ * les callbacks notent la voix via zml_gate (thread audio, comme l'arp). Le resample (ring
+ * audio) est mixé en post-FX par app.c via zml_bus_l/r, comme le bus drum.
+ *
+ * Le module est découplé d'app.c via les accesseurs zml_* définis dans app.c. */
+#pragma once
+#include <stdint.h>
+
+#define ZML_BUS_MAX 256u                 /* APP_BLOCK fm1-base = 256 */
+
+/* ---- fournis par app.c (patch 0008) ---- */
+float zml_sr(void);
+int   zml_tempo(void);
+int   zml_playing(void);                 /* le séquenceur tourne */
+void  zml_gate(int on, int note, int accent, int slide);
+void  zml_param(int key, float v);
+void  zml_say(const char *a, const char *b);
+
+/* ---- le module ---- */
+void  zml_init(float sr);
+void  zml_render(uint32_t n, const float *in);   /* in = bus mono du synth (resample) */
+const float *zml_bus_l(void);
+const float *zml_bus_r(void);
+
+/* recording (app.c -> ici depuis la file d'événements) */
+void  zml_note_in(int note, int vel);
+void  zml_note_off_in(int note);
+void  zml_par_in(int key, float v);
+void  zml_play_sync(void);               /* EV_PLAY : le looper suit le transport */
+
+/* page LOOP (12) : app.c route les touches/boutons/encodeurs ici */
+void  zml_slot_toggle(int slot);         /* touche blanche 0..15 */
+void  zml_encoder(int enc, int32_t det); /* enc = ordre enum : 0 SELECT 1 ALGO 2 PRESET 3..6 K1..K4 */
+void  zml_act_play(void);
+void  zml_act_rec(void);
+void  zml_act_od(void);
+void  zml_act_erase(void);
+void  zml_act_rs(void);
+void  zml_act_mutate(void);
+void  zml_act_rand(void);
+int   zml_sel(void);
+void  zml_gain(float g);                 /* macro / matrice ASSIGN : loop_gain 0..1 */
+float zml_gain_get(void);
