index f667295..b7c4b90 100644
--- a/atek303/app/ztek_drum.c
+++ b/atek303/app/ztek_drum.c
@@ -140,3 +140,49 @@ void zdr_act_clear(void)
     drum_clear_pat(&d, s_pad);
     zdr_say(DR_PAD_NAMES[s_pad], "CLEAR");
 }
+
+/* patch 0008: modulation du bus drum (matrice ASSIGN + macros). v 0..1. */
+void zdr_mod_set(int k, float v)
+{
+    int on;
+    float thr, ratio, mk;
+    v = clamp01(v);
+    switch (k) {
+    case 0: d.master = v; break;
+    case 1: d.swing = v * 0.5f; break;
+    case 2:
+        drum_get_comp(&d, &on, &thr, &ratio, &mk);
+        drum_set_comp(&d, on, thr, 1.0f + v * 19.0f, mk);
+        break;
+    case 3:
+        drum_get_comp(&d, &on, &thr, &ratio, &mk);
+        drum_set_comp(&d, v >= 0.5f ? 1 : 0, thr, ratio, mk);
+        break;
+    case 4: d.gmut = (int)(v * 255.0f); break;
+    case 5: d.glitch = v; break;
+    case 6: d.fx.dly_wet = v; break;
+    case 7: d.fx.rev_wet = v; break;
+    default: break;
+    }
+}
+
+float zdr_mod_get(int k)
+{
+    int on;
+    float thr, ratio, mk;
+    switch (k) {
+    case 0: return d.master;
+    case 1: return d.swing * 2.0f;
+    case 2:
+        drum_get_comp(&d, &on, &thr, &ratio, &mk);
+        return ratio > 1.0f ? (ratio - 1.0f) / 19.0f : 0.0f;
+    case 3:
+        drum_get_comp(&d, &on, &thr, &ratio, &mk);
+        return on ? 1.0f : 0.0f;
+    case 4: return d.gmut / 255.0f;
+    case 5: return d.glitch;
+    case 6: return d.fx.dly_wet;
+    case 7: return d.fx.rev_wet;
+    default: return 0.0f;
+    }
+}
