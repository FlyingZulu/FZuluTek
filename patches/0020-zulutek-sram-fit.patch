--- a/atek303/app/dsp/fx.c
+++ b/atek303/app/dsp/fx.c
@@ -162,6 +162,9 @@ enum { R_PRE, R_IN1, R_IN2, R_IN3, R_IN4, R_IN5, R_IN6, R_AP1L, R_D1L, R_AP2L, R
