+/* patch 0009: liaison APK (Android) <-> FM-1 « ZTF » — services companion + SysEx propre.
+ * Transport : USB-MIDI (même câble que l'audio USB et le backup). Voir docs/FM1-APK-LINK.md. */
+#define APP_COMPANION_EXTRAS "app=zuluTek;link=ztf;v=1"
+#define APP_SYSEX                                          /* app_sysex(): frames ZTF F0 7D 'Z' 'T' .. F7 */
+#define APP_FILES                                          /* fichiers ZSMP00..07 / ZLUP00..07 / ZMAC (ztek_link.c) */
+#define APP_FILE_OBJS { {OBJ_PRESETS_A, PLAT_FK_PRESET, PLAT_FF_READ|PLAT_FF_WRITE, "PRESETS_A"}, \
+                        {OBJ_PRESETS_B, PLAT_FK_PRESET, PLAT_FF_READ|PLAT_FF_WRITE, "PRESETS_B"}, \
+                        {OBJ_PRESETS_C, PLAT_FK_PRESET, PLAT_FF_READ|PLAT_FF_WRITE, "PRESETS_C"}, \
+                        {OBJ_PRESETS_D, PLAT_FK_PRESET, PLAT_FF_READ|PLAT_FF_WRITE, "PRESETS_D"}, \
+                        {OBJ_ZSEQ, PLAT_FK_SETTINGS, PLAT_FF_READ|PLAT_FF_WRITE, "ZSEQ"} }
+#define APP_PARAMS                                         /* table des params ztek_link.c (miroir live APK) */
+#define APP_USB_IN                                         /* hook audio USB entrant (patch fm1-base uac tap) */
+void app_usb_in(const int32_t *lr, uint32_t n);
+
 void app_init(void);
 void app_render(int32_t *lr, uint32_t n, uint32_t master_q12);
 void app_panic(void);
