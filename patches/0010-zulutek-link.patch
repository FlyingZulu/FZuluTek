diff --git a/atek303/app/ztek_macro.c b/atek303/app/ztek_macro.c
index 34a571d..ec7c6df 100644
--- a/atek303/app/ztek_macro.c
+++ b/atek303/app/ztek_macro.c
@@ -126,3 +126,39 @@ int   zmac_sel(void) { return sel; }
 int   zmac_used(int slot) { return (slot >= 0 && slot < ZMAC_N) ? mac[slot].used : 0; }
 int   zmac_dst(int slot) { return (slot >= 0 && slot < ZMAC_N) ? mac[slot].dst : 0; }
 float zmac_val(int slot) { return (slot >= 0 && slot < ZMAC_N) ? mac[slot].val : 0.0f; }
+
+/* ---- patch 0009: blob 'ZMC1' little-endian : 16 slots {dst i16, val f32, used u8} ---------- */
+int zmac_save(uint8_t *buf, int cap)
+{
+    int m;
+    uint8_t *p;
+    if (!buf || cap < 4 + ZMAC_N * 10) return -1;
+    p = buf;
+    p[0] = 'Z'; p[1] = 'M'; p[2] = 'C'; p[3] = '1';
+    p += 4;
+    for (m = 0; m < ZMAC_N; m++) {
+        int16_t d = (int16_t)mac[m].dst;
+        p[0] = (uint8_t)(d & 0xFF); p[1] = (uint8_t)((uint16_t)d >> 8);
+        memcpy(p + 2, &mac[m].val, 4);
+        p[6] = (uint8_t)(mac[m].used ? 1 : 0);
+        p += 10;
+    }
+    return 4 + ZMAC_N * 10;
+}
+
+int zmac_load(const uint8_t *buf, int len)
+{
+    int m;
+    const uint8_t *p;
+    if (!buf || len < 4 + ZMAC_N * 10) return -1;
+    if (buf[0] != 'Z' || buf[1] != 'M' || buf[2] != 'C' || buf[3] != '1') return -1;
+    p = buf + 4;
+    for (m = 0; m < ZMAC_N; m++) {
+        int16_t d = (int16_t)((uint16_t)p[0] | ((uint16_t)p[1] << 8));
+        mac[m].dst = d;
+        memcpy(&mac[m].val, p + 2, 4);
+        mac[m].used = p[6] ? 1 : 0;
+        p += 10;
+    }
+    return 0;
+}
