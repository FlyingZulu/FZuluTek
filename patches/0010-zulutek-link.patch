@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_link: la liaison APK (Android) <-> FM-1 « ZTF » — patch 0009.
+ *
+ * Transport : USB-MIDI SysEx (le même câble que l'audio USB et le backup). Deux familles :
+ *   - les services companion du platform (fm1.toml companion = true) : cmd 0x60 capability,
+ *     0x61 files (APP_FILES ci-dessous + APP_FILE_OBJS = presets/ZSEQ en app.h), 0x62 params (APP_PARAMS) ;
+ *   - nos frames propres ZTF : F0 7D 'Z' 'T' cmd args.. F7 (reçues via APP_SYSEX -> app_sysex,
+ *     réponses via plat_sysex_send).
+ *
+ * Fichiers APP_FILES (zone data flash, copies A/B plat_file_t) :
+ *   ZSMP00..07  PLAT_FK_SAMPLE  blob 'ZSM1' : sr u32, len u32, fmt u8 (0 int16, 1 µ-law), data
+ *               -> zml_ring_import (le sample devient une boucle audio du slot)
+ *   ZLUP00..07  PLAT_FK_BANK    blob 'ZLS1' d'un slot looper -> zml_slot_load
+ *   ZMAC        PLAT_FK_SETTINGS blob 'ZMC1' des 16 macros -> zmac_load
+ *
+ * Commandes ZTF (après F0 7D 5A 54) :
+ *   'P' PING            -> réponse 'P' + "zuluTek" + version + octets libres zone data
+ *   'R' idx             -> réponse 'R' idx + valeur u32 (param i, 0..1000 ou brut)
+ *   'W' idx val(u32)    -> set param, réponse 'W' idx ok
+ *   'G'                 -> réponse 'G' + page courante
+ *   'S' page            -> set page, réponse 'S' ok
+ *   'T' note vel        -> note on (EV_NOTE_ON), réponse 'T' ok
+ *   'O' note            -> note off, réponse 'O' ok
+ *   'Y'                 -> PLAY/STOP (EV_PLAY), réponse 'Y' ok
+ *   'L' fileidx         -> réapplique le fichier idx depuis la flash (LOAD), réponse 'L' idx ok/err
+ *
+ * Le module est découplé d'app.c via les accesseurs zlk_* définis dans app.c. */
+#pragma once
+#include <stdint.h>
+#include "plat.h"
+
+void zlk_init(void);
+int  zlk_sysex(const uint8_t *p, uint32_t n);            /* 1 = frame ZTF prise en charge */
+
+/* fichiers companion (APP_FILES) — appelés par le platform */
+int  zlk_file(int i, plat_file_info_t *f);
+int  zlk_file_read(int i, uint32_t off, void *dst, uint32_t n);
+int  zlk_file_begin(int i, uint32_t size);
+int  zlk_file_write(int i, uint32_t off, const void *src, uint32_t n);
+int  zlk_file_commit(int i, uint32_t size, uint32_t crc);
+int  zlk_file_delete(int i);
+int  zlk_file_busy(void);
+
+/* paramètres companion (APP_PARAMS) */
+int         zlk_param(int i, plat_param_t *p);
+const char *zlk_param_group(int g);
+int32_t     zlk_param_get(int i);
+int32_t     zlk_param_set(int i, int32_t v);
+
+/* ---- fournis par app.c (patch 0009) ---- */
+float *zlk_at_params(void);
+float *zlk_fx_params(void);
+void  zlk_at_set(int k, float v);
+void  zlk_fx_set(int k, float v);
+int   zlk_tempo(void);
+void  zlk_tempo_set(int b);
+int   zlk_page(void);
+void  zlk_page_set(int p);
+void  zlk_play(void);
+void  zlk_note_on(int note, int vel);
+void  zlk_note_off(int note);
+float zlk_loop_gain(void);
+void  zlk_loop_gain_set(float g);
+float zlk_swing(void);
+void  zlk_swing_set(float v);
+uint32_t zlk_data_free(void);               /* octets libres estimés dans la zone data */
diff --git a/atek303/app/ztek_loop.c b/atek303/app/ztek_loop.c
index e58f581..38b9da7 100644
--- a/atek303/app/ztek_loop.c
+++ b/atek303/app/ztek_loop.c
@@ -272,3 +272,144 @@ int zml_sel(void) { return ml.sel; }
 
 void zml_gain(float g) { ml.loop_gain = clamp01(g); }
 float zml_gain_get(void) { return ml.loop_gain; }
+
+/* ---- patch 0009: import/export liaison APK <-> FM-1 ---------------------------------- */
+
+/* importe un sample reçu (fichier ZSMPxx) dans le ring resample d'un slot : le slot devient
+ * une boucle audio jouable. fmt 0 = int16, 1 = µ-law. ring_sr = fréquence d'échantillonnage du ring. */
+int zml_ring_import(int slot, int fmt, uint32_t ring_sr, uint32_t len, const void *data)
+{
+    ml_slot_t *s;
+    uint32_t cap, i;
+    float spu;
+    uint16_t l;
+    if (slot < 0 || slot >= ML_NSLOTS || !data) return -1;
+    cap = fmt ? (uint32_t)ML_RS_MAX * 2u : (uint32_t)ML_RS_MAX;
+    if (len > cap) len = cap;
+    if (len < 64) return -1;
+    s = &ml.slot[slot];
+    ml.rs_fmt = fmt ? 1 : 0;
+    ml.rs_decim = ring_sr > 0 ? ml.sr / (float)ring_sr : 1.0f;
+    if (ml.rs_decim < 1.0f) ml.rs_decim = 1.0f;
+    ml.rs_bits = 16;
+    ml.rs_rec = 0;
+    ml.rs_dst = slot;
+    ml.rs_cap = cap;
+    ml.rs_len = len;
+    ml.rs_pos = 0;
+    ml.rs_ph = 0.0f;
+    ml.rs_rph = 0.0f;
+    if (fmt) memcpy(ml.rs_ring.b, data, len);
+    else {
+        const int16_t *w = (const int16_t *)data;
+        for (i = 0; i < len; i++) ml.rs_ring.w[i] = w[i];
+    }
+    spu = (ml.sr / ml.rs_decim) / ((float)zml_tempo() * 16.0f / 60.0f);   /* éch. par 1/64 de mesure, au ring */
+    l = (uint16_t)(len / spu);
+    if (l < 16) l = 16;
+    s->len = l;
+    s->len_set = 1;
+    s->rs = 1;
+    s->on = 1;
+    s->rec = 0;
+    s->pos = 0.0f;
+    s->last_pos = 0.0f;
+    ml.sel = slot;
+    return 0;
+}
+
+static void put16(uint8_t *p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static uint32_t get16(const uint8_t *p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8); }
+
+/* blob 'ZLS1' explicite (little-endian) : sp, len, flags, notes, param events — relisable côté APK */
+int zml_slot_save(int slot, uint8_t *buf, int cap)
+{
+    ml_slot_t *s;
+    uint32_t n, i;
+    uint8_t *p;
+    if (slot < 0 || slot >= ML_NSLOTS || !buf) return -1;
+    s = &ml.slot[slot];
+    n = 16u + (uint32_t)s->n_note * 4u + (uint32_t)s->n_par * 8u;
+    if (cap < (int)n) return -1;
+    p = buf;
+    p[0] = 'Z'; p[1] = 'L'; p[2] = 'S'; p[3] = '1';
+    p[4] = (uint8_t)s->sp.pitch;
+    put16(p + 5, s->sp.pos);
+    p[7] = s->sp.mode; p[8] = s->sp.mut; p[9] = s->sp.src; p[10] = s->sp.fx; p[11] = s->sp.vol;
+    put16(p + 12, s->len);
+    p[14] = s->len_set; p[15] = s->on;
+    put16(p + 16, s->n_note);
+    p += 18;
+    for (i = 0; i < s->n_note; i++) {
+        put16(p, s->note[i].t);
+        p[2] = s->note[i].note; p[3] = s->note[i].vel; p[4] = s->note[i].dur;
+        p += 5;
+        n = 18u + (uint32_t)s->n_note * 5u + (uint32_t)s->n_par * 8u;
+    }
+    /* recalcule proprement la taille (notes en 5 o) */
+    n = 18u + (uint32_t)s->n_note * 5u + 2u + (uint32_t)s->n_par * 8u;
+    if (cap < (int)n) return -1;
+    put16(p, s->n_par);
+    p += 2;
+    for (i = 0; i < s->n_par; i++) {
+        put16(p, s->par[i].t);
+        p[2] = s->par[i].key; p[3] = 0;
+        memcpy(p + 4, &s->par[i].v, 4);
+        p += 8;
+    }
+    return (int)(18u + (uint32_t)s->n_note * 5u + 2u + (uint32_t)s->n_par * 8u);
+}
+
+int zml_slot_load(int slot, const uint8_t *buf, int len)
+{
+    ml_slot_t *s;
+    const uint8_t *p;
+    uint32_t n_note, n_par, i;
+    if (slot < 0 || slot >= ML_NSLOTS || !buf || len < 18) return -1;
+    if (buf[0] != 'Z' || buf[1] != 'L' || buf[2] != 'S' || buf[3] != '1') return -1;
+    s = &ml.slot[slot];
+    p = buf;
+    s->sp.pitch = (int8_t)p[4];
+    s->sp.pos = (uint16_t)get16(p + 5);
+    s->sp.mode = p[7]; s->sp.mut = p[8]; s->sp.src = p[9]; s->sp.fx = p[10]; s->sp.vol = p[11];
+    s->len = (uint16_t)get16(p + 12);
+    s->len_set = p[14]; s->on = p[15];
+    n_note = get16(p + 16);
+    p += 18;
+    if (n_note > ML_MAXEV) n_note = ML_MAXEV;
+    if ((uint32_t)len < 18u + n_note * 5u + 2u) return -1;
+    s->n_note = (uint16_t)n_note;
+    for (i = 0; i < n_note; i++) {
+        s->note[i].t = (uint16_t)get16(p);
+        s->note[i].note = p[2]; s->note[i].vel = p[3]; s->note[i].dur = p[4];
+        p += 5;
+    }
+    n_par = get16(p);
+    p += 2;
+    if (n_par > ML_MAXPEV) n_par = ML_MAXPEV;
+    if ((uint32_t)len < 18u + (uint32_t)s->n_note * 5u + 2u + n_par * 8u) return -1;
+    s->n_par = (uint16_t)n_par;
+    for (i = 0; i < n_par; i++) {
+        s->par[i].t = (uint16_t)get16(p);
+        s->par[i].key = p[2];
+        memcpy(&s->par[i].v, p + 4, 4);
+        p += 8;
+    }
+    s->rec = 0;
+    s->rs = 0;
+    s->pos = 0.0f;
+    s->last_pos = 0.0f;
+    s->n_act = 0;
+    return 0;
+}
+
+/* audio entrant USB (hook app_usb_in, patch fm1-base) : alimente le ring si un REC resample est armé */
+void zml_usb_feed(const int32_t *lr, uint32_t n)
+{
+    static float f[ZML_BUS_MAX];
+    uint32_t i;
+    if (!ml.rs_rec || !lr || n > ZML_BUS_MAX) return;
+    for (i = 0; i < n; i++)
+        f[i] = (float)lr[2u * i] / 8388608.0f;    /* 24-bit -> [-1, 1) */
+    ml_rs_feed(&ml, f, n);
+}
