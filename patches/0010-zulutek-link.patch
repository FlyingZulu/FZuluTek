diff --git a/atek303/app/ztek_link.c b/atek303/app/ztek_link.c
new file mode 100644
index 0000000..d4bbb2e
--- /dev/null
+++ b/atek303/app/ztek_link.c
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_link.c — voir ztek_link.h. C99, pas d'allocation dynamique.
+ * Les fichiers vivent en flash (zone data, copies A/B via plat_file_t) ; à chaque commit on
+ * relit et on applique (sample -> ring looper, slot -> looper, macros). */
+#include <string.h>
+#include "ztek_link.h"
+#include "ztek_loop.h"
+#include "ztek_macro.h"
+#include "dsp/fx.h"
+
+#define ZLK_NSMP 8
+#define ZLK_NLUP 8
+#define ZLK_NFILE (ZLK_NSMP + ZLK_NLUP + 1)          /* + ZMAC */
+
+/* copies A/B dans la zone data (0x97000..0xD3FFF libre sous la zone app 0xD4000..) :
+ * samples 0xB0000.., loops 0xC0000.., ZMAC 0xD0000.. ; n = 0x1000 (1 secteur A + 1 secteur B) */
+#define ZLK_SMP_BASE 0xB0000u
+#define ZLK_LUP_BASE 0xC0000u
+#define ZLK_MAC_A    0xD0000u
+#define ZLK_MAC_B    0xD1000u
+#define ZLK_FN       0x1000u
+
+static const plat_file_t zlk_files[ZLK_NFILE] = {
+    { ZLK_SMP_BASE + 0u * 0x2000u, ZLK_SMP_BASE + 0u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_SMP_BASE + 1u * 0x2000u, ZLK_SMP_BASE + 1u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_SMP_BASE + 2u * 0x2000u, ZLK_SMP_BASE + 2u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_SMP_BASE + 3u * 0x2000u, ZLK_SMP_BASE + 3u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_SMP_BASE + 4u * 0x2000u, ZLK_SMP_BASE + 4u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_SMP_BASE + 5u * 0x2000u, ZLK_SMP_BASE + 5u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_SMP_BASE + 6u * 0x2000u, ZLK_SMP_BASE + 6u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_SMP_BASE + 7u * 0x2000u, ZLK_SMP_BASE + 7u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 0u * 0x2000u, ZLK_LUP_BASE + 0u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 1u * 0x2000u, ZLK_LUP_BASE + 1u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 2u * 0x2000u, ZLK_LUP_BASE + 2u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 3u * 0x2000u, ZLK_LUP_BASE + 3u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 4u * 0x2000u, ZLK_LUP_BASE + 4u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 5u * 0x2000u, ZLK_LUP_BASE + 5u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 6u * 0x2000u, ZLK_LUP_BASE + 6u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_LUP_BASE + 7u * 0x2000u, ZLK_LUP_BASE + 7u * 0x2000u + 0x1000u, ZLK_FN },
+    { ZLK_MAC_A, ZLK_MAC_B, ZLK_FN },
+};
+
+static const char *const ZLK_NAMES[ZLK_NFILE] = {
+    "ZSMP00", "ZSMP01", "ZSMP02", "ZSMP03", "ZSMP04", "ZSMP05", "ZSMP06", "ZSMP07",
+    "ZLUP00", "ZLUP01", "ZLUP02", "ZLUP03", "ZLUP04", "ZLUP05", "ZLUP06", "ZLUP07",
+    "ZMAC",
+};
+
+static int cur_file = -1;
+static uint32_t cur_size;
+
+void zlk_init(void)
+{
+    cur_file = -1;
+}
+
+/* applique un fichier commité (relit depuis la flash et applique au moteur) ; 0 ok */
+static int zlk_apply(int i)
+{
+    const plat_file_t *f = &zlk_files[i];
+    const uint8_t *d;
+    int sz;
+    if (i < 0 || i >= ZLK_NFILE) return -1;
+    sz = plat_file_size(f);
+    if (sz <= 0) return -1;
+    d = plat_file_data(f);
+    if (!d) return -1;
+    if (i < ZLK_NSMP) {                          /* ZSMPxx : 'ZSM1' sr u32 len u32 fmt u8 data */
+        uint32_t sr, len;
+        int fmt;
+        if (sz < 13 || d[0] != 'Z' || d[1] != 'S' || d[2] != 'M' || d[3] != '1') return -2;
+        sr = (uint32_t)d[4] | ((uint32_t)d[5] << 8) | ((uint32_t)d[6] << 16) | ((uint32_t)d[7] << 24);
+        len = (uint32_t)d[8] | ((uint32_t)d[9] << 8) | ((uint32_t)d[10] << 16) | ((uint32_t)d[11] << 24);
+        fmt = d[12];
+        if ((uint32_t)sz < 13u + len) return -3;
+        return zml_ring_import(i, fmt, sr, len, d + 13);
+    }
+    if (i < ZLK_NSMP + ZLK_NLUP)                  /* ZLUPxx : blob 'ZLS1' du slot */
+        return zml_slot_load(i - ZLK_NSMP, d, sz);
+    return zmac_load(d, sz);                     /* ZMAC */
+}
+
+/* ---- fichiers companion ------------------------------------------------------------ */
+
+int zlk_file(int i, plat_file_info_t *f)
+{
+    int sz;
+    if (!f) return -1;
+    if (i < 0 || i >= ZLK_NFILE) return -1;
+    sz = plat_file_size(&zlk_files[i]);
+    f->name = ZLK_NAMES[i];
+    f->kind = i < ZLK_NSMP ? PLAT_FK_SAMPLE : (i < ZLK_NSMP + ZLK_NLUP ? PLAT_FK_BANK : PLAT_FK_SETTINGS);
+    f->flags = PLAT_FF_READ | PLAT_FF_WRITE | PLAT_FF_DELETE | PLAT_FF_PLAYING;
+    f->size = sz > 0 ? (uint32_t)sz : 0u;
+    f->room = ZLK_FN - PLAT_FILE_HEAD;
+    return 0;
+}
+
+int zlk_file_read(int i, uint32_t off, void *dst, uint32_t n)
+{
+    if (i < 0 || i >= ZLK_NFILE) return -1;
+    return plat_file_read(&zlk_files[i], off, dst, n);
+}
+
+int zlk_file_begin(int i, uint32_t size)
+{
+    if (i < 0 || i >= ZLK_NFILE || size > ZLK_FN - PLAT_FILE_HEAD) return -1;
+    cur_file = i;
+    cur_size = size;
+    return plat_file_begin(&zlk_files[i], size);
+}
+
+int zlk_file_write(int i, uint32_t off, const void *src, uint32_t n)
+{
+    if (i != cur_file || i < 0 || i >= ZLK_NFILE) return -1;
+    if (off + n > cur_size) return -1;
+    return plat_file_write(&zlk_files[i], off, src, n);
+}
+
+int zlk_file_commit(int i, uint32_t size, uint32_t crc)
+{
+    int rc;
+    if (i != cur_file || i < 0 || i >= ZLK_NFILE) return -1;
+    rc = plat_file_commit(&zlk_files[i], size, crc);
+    if (rc == 0)
+        zlk_apply(i);                            /* commit ok -> on applique au moteur */
+    cur_file = -1;
+    return rc;
+}
+
+int zlk_file_delete(int i)
+{
+    if (i < 0 || i >= ZLK_NFILE) return -1;
+    return plat_file_delete(&zlk_files[i]);
+}
+
+int zlk_file_busy(void) { return 0; }            /* les fichiers ZTF sont sûrs même en jouant */
+
+/* ---- paramètres companion (APP_PARAMS) ---------------------------------------------- */
+
+enum { P_CUTOFF, P_RESO, P_ENVMOD, P_DECAY, P_WAVE, P_ENGINE, P_TEMPO, P_PAGE,
+       P_LOOPGAIN, P_DLYTIME, P_REVMIX, P_SWING, P_N };
+static const char *const ZLK_GRP[4] = { "VOICE", "SEQ", "LOOP", "DRUM" };
+static const char *const ZLK_PNAME[P_N] = { "CUTOFF", "RESO", "ENV MOD", "DECAY", "WAVE", "ENGINE",
+                                             "TEMPO", "PAGE", "LOOP GAIN", "DLY TIME", "REV MIX", "SWING" };
+
+int zlk_param(int i, plat_param_t *p)
+{
+    if (!p) return -1;
+    if (i < 0 || i >= P_N) return -1;
+    memset(p, 0, sizeof *p);
+    p->id = (uint16_t)i;
+    p->type = PLAT_PT_NUMBER;
+    p->group = (uint8_t)(i <= P_ENGINE ? 0 : (i <= P_PAGE ? 1 : (i <= P_REVMIX ? 2 : 3)));
+    p->name = ZLK_PNAME[i];
+    p->unit = 0;
+    if (i == P_TEMPO) { p->min = 30; p->max = 300; p->def = 120; }
+    else if (i == P_PAGE) { p->min = 0; p->max = 13; p->def = 0; }
+    else { p->min = 0; p->max = 1000; p->def = 500; }
+    return 0;
+}
+
+const char *zlk_param_group(int g) { return (g >= 0 && g < 4) ? ZLK_GRP[g] : 0; }
+
+static float zlk_param_f(int i)   /* valeur 0..1 (ou bpm/page en brut via get) */
+{
+    float *at = zlk_at_params(), *fx = zlk_fx_params();
+    switch (i) {
+    case P_CUTOFF: return at[AT_CUTOFF];
+    case P_RESO: return at[AT_RESONANCE];
+    case P_ENVMOD: return at[AT_ENVMOD];
+    case P_DECAY: return at[AT_DECAY];
+    case P_WAVE: return at[AT_WAVE];
+    case P_ENGINE: return at[AT_ENGINE];
+    case P_LOOPGAIN: return zlk_loop_gain();
+    case P_DLYTIME: return fx[FX_DLY_TIME];
+    case P_REVMIX: return fx[FX_REV_MIX];
+    case P_SWING: return zlk_swing();
+    default: return 0.5f;
+    }
+}
+
+int32_t zlk_param_get(int i)
+{
+    if (i == P_TEMPO) return zlk_tempo();
+    if (i == P_PAGE) return zlk_page();
+    if (i < 0 || i >= P_N) return 0;
+    return (int32_t)(zlk_param_f(i) * 1000.0f + 0.5f);
+}
+
+int32_t zlk_param_set(int i, int32_t v)
+{
+    float f;
+    if (i < 0 || i >= P_N) return 0;
+    if (i == P_TEMPO) { zlk_tempo_set((int)v); return zlk_tempo(); }
+    if (i == P_PAGE) { zlk_page_set((int)v); return zlk_page(); }
+    if (v < 0) v = 0;
+    if (v > 1000) v = 1000;
+    f = (float)v / 1000.0f;
+    switch (i) {
+    case P_CUTOFF: zlk_at_set(AT_CUTOFF, f); break;
+    case P_RESO: zlk_at_set(AT_RESONANCE, f); break;
+    case P_ENVMOD: zlk_at_set(AT_ENVMOD, f); break;
+    case P_DECAY: zlk_at_set(AT_DECAY, f); break;
+    case P_WAVE: zlk_at_set(AT_WAVE, f); break;
+    case P_ENGINE: zlk_at_set(AT_ENGINE, f); break;
+    case P_LOOPGAIN: zlk_loop_gain_set(f); break;
+    case P_DLYTIME: zlk_fx_set(FX_DLY_TIME, f); break;
+    case P_REVMIX: zlk_fx_set(FX_REV_MIX, f); break;
+    case P_SWING: zlk_swing_set(f); break;
+    default: break;
+    }
+    return (int32_t)(f * 1000.0f + 0.5f);
+}
+
+/* ---- frames ZTF (APP_SYSEX) ---------------------------------------------------------- */
+
+static void zlk_reply(const uint8_t *body, uint32_t n)
+{
+    uint8_t f[40];
+    if (n > 32) n = 32;
+    f[0] = 0xF0; f[1] = 0x7D; f[2] = 'Z'; f[3] = 'T';
+    memcpy(f + 4, body, n);
+    f[4 + n] = 0xF7;
+    plat_sysex_send(f, 5u + n);
+}
+
+static void put32(uint8_t *p, uint32_t v)
+{ p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24); }
+
+int zlk_sysex(const uint8_t *p, uint32_t n)
+{
+    uint8_t r[36];
+    if (!p || n < 4) return 0;
+    if (p[0] != 0x7D || p[1] != 'Z' || p[2] != 'T') return 0;    /* pas ZTF : on ne prend pas */
+    switch (p[3]) {
+    case 'P':                                          /* PING -> PONG + nom + version + libre */
+        r[0] = 'P';
+        memcpy(r + 1, "zuluTek", 7);
+        r[8] = 1;                                      /* version du protocole ZTF */
+        put32(r + 9, zlk_data_free());
+        zlk_reply(r, 13);
+        return 1;
+    case 'R':                                          /* GET param idx */
+        if (n < 5) return 1;
+        r[0] = 'R'; r[1] = p[4];
+        put32(r + 2, (uint32_t)zlk_param_get((int)p[4]));
+        zlk_reply(r, 6);
+        return 1;
+    case 'W':                                          /* SET param idx val */
+        if (n < 9) return 1;
+        {
+            uint32_t v = (uint32_t)p[5] | ((uint32_t)p[6] << 8) | ((uint32_t)p[7] << 16) | ((uint32_t)p[8] << 24);
+            int32_t now = zlk_param_set((int)p[4], (int32_t)v);
+            r[0] = 'W'; r[1] = p[4];
+            put32(r + 2, (uint32_t)now);
+            zlk_reply(r, 6);
+        }
+        return 1;
+    case 'G':                                          /* GET page */
+        r[0] = 'G'; r[1] = (uint8_t)zlk_page();
+        zlk_reply(r, 2);
+        return 1;
+    case 'S':                                          /* SET page */
+        if (n < 5) return 1;
+        zlk_page_set((int)p[4]);
+        r[0] = 'S'; r[1] = p[4];
+        zlk_reply(r, 2);
+        return 1;
+    case 'T':                                          /* TRIG note vel */
+        if (n < 6) return 1;
+        zlk_note_on((int)p[4], (int)p[5]);
+        r[0] = 'T'; r[1] = p[4];
+        zlk_reply(r, 2);
+        return 1;
+    case 'O':                                          /* note OFF */
+        if (n < 5) return 1;
+        zlk_note_off((int)p[4]);
+        r[0] = 'O'; r[1] = p[4];
+        zlk_reply(r, 2);
+        return 1;
+    case 'Y':                                          /* PLAY/STOP */
+        zlk_play();
+        r[0] = 'Y';
+        zlk_reply(r, 1);
+        return 1;
+    case 'L':                                          /* LOAD fichier idx depuis la flash */
+        if (n < 5) return 1;
+        {
+            int rc = zlk_apply((int)p[4]);
+            r[0] = 'L'; r[1] = p[4]; r[2] = (uint8_t)(rc == 0 ? 0 : 1);
+            zlk_reply(r, 3);
+        }
+        return 1;
+    default:
+        return 1;                                      /* ZTF mais commande inconnue : on a pris */
+    }
+}
