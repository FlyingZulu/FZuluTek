diff --git a/atek303/app/app.c b/atek303/app/app.c
index d41d4a5..fcc477c 100644
--- a/atek303/app/app.c
+++ b/atek303/app/app.c
@@ -63,6 +63,7 @@
 #include "ztek_drum.h"     /* patch 0007: drum machine, page DRUM (11) */
 #include "ztek_loop.h"     /* patch 0008: MIDI looper, page LOOP (12) */
 #include "ztek_macro.h"    /* patch 0008: macros 16 slots, page MACRO (13) */
+#include "ztek_link.h"     /* patch 0009: liaison APK <-> FM-1 ZTF (companion files/params + SysEx) */
 
 /* the Animatek palette, as on the VCV Rack modules (UZZ-VCV-RACK src/ui/CommonWidgets.hpp, AcidEditor.hpp):
  * the screens are slate, the values in the displays' blue, the selection in the logo's blue */
@@ -1105,6 +1106,7 @@ void app_init(void)
     zdr_init((float)SR);                  /* patch 0007: drum machine */
     zml_init((float)SR);                  /* patch 0008: MIDI looper */
     zmac_init();                          /* patch 0008: macros */
+    zlk_init();                           /* patch 0009: liaison APK <-> FM-1 ZTF */
     int i;
     at_init(&voice, SR);
     options_load();
@@ -1215,6 +1217,50 @@ void  zml_gate(int on, int note, int accent, int slide) { at_gate(&voice, on, no
 void  zml_param(int key, float v) { if (key >= 0 && key < AT_NPARAMS) { set.param[key] = v; at_set(&voice, key, v); } }
 void  zml_say(const char *a, const char *b) { app_say(a, b); }
 void  zmac_say(const char *a, const char *b) { app_say(a, b); }
+
+/* ---- patch 0009: accesseurs + hooks companion/ZTF pour ztek_link.c ---- */
+float *zlk_at_params(void) { return set.param; }
+float *zlk_fx_params(void) { return set.fx; }
+void  zlk_at_set(int k, float v) { if (k >= 0 && k < AT_NPARAMS) { set.param[k] = v; at_set(&voice, k, v); } }
+void  zlk_fx_set(int k, float v) { if (k >= 0 && k < FX_NPARAMS) { set.fx[k] = v; fx_set(k, v); } set_dirty = 1; }
+int   zlk_tempo(void) { return set.tempo; }
+void  zlk_tempo_set(int b) { set.tempo = (uint16_t)(b < 30 ? 30 : b > 300 ? 300 : b); set_dirty = 1; }
+int   zlk_page(void) { return set.page; }
+void  zlk_page_set(int p) { set.page = (uint8_t)(p < 0 ? 0 : p >= NPAGES ? NPAGES - 1 : p); ui.edit = ui.list = 0; ui.redraw = 1; }
+void  zlk_play(void) { post(EV_PLAY, 0, 0); }
+void  zlk_note_on(int note, int vel) { post(EV_NOTE_ON, (uint32_t)note, (uint32_t)(vel ? vel : 100)); }
+void  zlk_note_off(int note) { post(EV_NOTE_OFF, (uint32_t)note, 0); }
+float zlk_loop_gain(void) { return zml_gain_get(); }
+void  zlk_loop_gain_set(float g) { zml_gain(g); }
+float zlk_swing(void) { return zdr_mod_get(1); }
+void  zlk_swing_set(float v) { zdr_mod_set(1, v); }
+uint32_t zlk_data_free(void) { return 0xD4000u - 0xD2000u; }   /* estimation: ce qui reste sous la zone app */
+
+int app_sysex(const uint8_t *p, uint32_t n) { return zlk_sysex(p, n); }
+int app_file(int i, plat_file_info_t *f) { return zlk_file(i, f); }
+int app_file_read(int i, uint32_t off, void *dst, uint32_t n) { return zlk_file_read(i, off, dst, n); }
+int app_file_begin(int i, uint32_t size) { return zlk_file_begin(i, size); }
+int app_file_write(int i, uint32_t off, const void *src, uint32_t n) { return zlk_file_write(i, off, src, n); }
+int app_file_commit(int i, uint32_t size, uint32_t crc) { return zlk_file_commit(i, size, crc); }
+int app_file_delete(int i) { return zlk_file_delete(i); }
+int app_file_busy(void) { return zlk_file_busy(); }
+int app_param(int i, plat_param_t *p) { return zlk_param(i, p); }
+const char *app_param_group(int g) { return zlk_param_group(g); }
+int32_t app_param_get(int i) { return zlk_param_get(i); }
+int32_t app_param_set(int i, int32_t v) { return zlk_param_set(i, v); }
+void app_usb_in(const int32_t *lr, uint32_t n) { zml_usb_feed(lr, n); }   /* patch 0009 + patch fm1-base: audio USB entrant */
+void app_file_changed(uint32_t obj)              /* un objet store réécrit par l'ordinateur (presets/ZSEQ) */
+{
+    int b;
+    if (obj >= OBJ_PRESETS_A && obj <= OBJ_PRESETS_D) {
+        b = (int)(obj - OBJ_PRESETS_A);
+        plat_store_load(obj, &presets[b * PRESETS_PER_OBJ], sizeof(preset_t) * PRESETS_PER_OBJ);
+        ui.redraw = 1;
+    } else if (obj == OBJ_ZSEQ) {
+        zsp_flash_load();
+        ui.redraw = 1;
+    }
+}
 int  app_preset_used_raw(int slot) { return presets[slot].used; }
 void app_preset_set_used_raw(int slot, int raw) { presets[slot].used = (unsigned)raw; set_dirty = 1; }
 
