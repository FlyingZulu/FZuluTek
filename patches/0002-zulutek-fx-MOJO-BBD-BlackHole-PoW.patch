+void fx_punch(int on, int type, float a, float b, float mix)
+{
+    if (on && !pn.on) {                        /* a new punch: the heads at the write pos, the loop fresh */
+        pn.rd_f = 0.0f;
+        pn.rate = 1.0f;
+        pn.ph = 0.0f;
+        pn.lp = 0.0f;
+        pn.t = 0.0f;
+        pn.cyc = 1.0f;
+        pn.L = 0.0f;
