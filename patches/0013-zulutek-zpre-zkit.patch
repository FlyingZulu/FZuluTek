+/* patch 0013: export/import d'un kit en blob 'ZKT1' (fichiers companion ZKIT00..02) */
+int drum_kit_export(int kit, uint8_t *buf, int cap)
+{
+    dr_zkt1_t t;
+    if (kit < 0 || kit >= DR_KIT_N || !buf || cap < (int)sizeof t) return 0;
+    memset(&t, 0, sizeof t);
+    t.magic = DR_ZKT1_MAGIC;
+    t.kit = (uint32_t)kit;
+    memcpy(t.name, DR_KIT_NAMES[kit], sizeof t.name - 1);
+    for (int p = 0; p < DR_NPADS; p++)
+        memcpy(t.par[p], KITPAR[kit][p], sizeof t.par[p]);
+    memcpy(buf, &t, sizeof t);
+    return (int)sizeof t;
+}
+
+int drum_kit_import(drum_t *d, int kit, const uint8_t *buf, int len)
+{
+    dr_zkt1_t t;
+    if (!d || kit < 0 || kit >= DR_KIT_N || !buf || len != (int)sizeof t) return 0;
+    memcpy(&t, buf, sizeof t);
+    if (t.magic != DR_ZKT1_MAGIC || (int)t.kit != kit) return 0;
+    for (int p = 0; p < DR_NPADS; p++)
+        memcpy(d->pad[p].par, t.par[p], sizeof d->pad[p].par);
+    return 1;
+}
