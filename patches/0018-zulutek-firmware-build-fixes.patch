     return 0;
 }
 
+static void zlk_mkname(char *dst, const char *pfx, int k)   /* "ZPRE%02d" sans snprintf (pas de libc printf au build FM-1) */
+{
+    dst[0] = pfx[0]; dst[1] = pfx[1]; dst[2] = pfx[2]; dst[3] = pfx[3];
+    dst[4] = (char)('0' + k / 10); dst[5] = (char)('0' + k % 10); dst[6] = 0;
+}
+
 void zlk_init(void)
 {
     int k;
     cur_file = -1;
     for (k = 0; k < ZLK_NPRE; k++)
-        snprintf(zlk_vnames[k], 8, "ZPRE%02d", k);
+        zlk_mkname(zlk_vnames[k], "ZPRE", k);
     for (k = 0; k < ZLK_NKIT; k++)
-        snprintf(zlk_vnames[ZLK_NPRE + k], 8, "ZKIT%02d", k);
+        zlk_mkname(zlk_vnames[ZLK_NPRE + k], "ZKIT", k);
 }
 
