  * mixée pre-FX (le bus mono part dans fx_process, comme la chaîne APK : … → siren → fx → out). */
 #include <math.h>
 #include <string.h>
+#ifndef PLAT_HOST                       /* au build FM-1, libm n'est pas lié */
+#include "fastmath.h"
+#define sinf(x)    fm_sinf(x)
+#define expf(x)    fm_expf(x)
+static float sir_fmodf(float x, float y) { return x - fm_floorf(x / y) * y; }   /* fmodf à y > 0 */
+#define fmodf(x,y) sir_fmodf(x,y)
+#endif
