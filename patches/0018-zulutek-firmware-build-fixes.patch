diff --git a/atek303/app/ztek_drum_fm1.c b/atek303/app/ztek_drum_fm1.c
index 526019f..fc21a01 100644
--- a/atek303/app/ztek_drum_fm1.c
+++ b/atek303/app/ztek_drum_fm1.c
@@ -5,4 +5,15 @@
  * DR_FM1_ECO réduit le ring du delay (8192 éch. au lieu de 16384) pour la RAM de l'AC791N.
  * Le fichier dsp/drum_engine.c reste vendored tel quel (même source que l'APK, PR #5). */
 #define DR_FM1_ECO 1
+#ifndef PLAT_HOST                       /* au build FM-1, libm n'est pas lié : les appels libm du vendored */
+#include "fastmath.h"                    /* drum_engine.c (même source que l'APK, PR #5) passent par fm_* */
+#define floorf(x)  fm_floorf(x)
+#define sinf(x)    fm_sinf(x)
+#define cosf(x)    fm_cosf(x)
+#define expf(x)    fm_expf(x)
+#define powf(x,y)  fm_powf(x,y)
+#define sqrtf(x)   fm_sqrtf(x)
+#define fabsf(x)   fm_fabsf(x)
+#define tanhf(x)   fm_tanhf(x)
+#endif
 #include "dsp/drum_engine.c"
