@@ -4,6 +4,7 @@
  * ztek_drum.c — glue FM-1 de la drum machine (voir ztek_drum.h). C99, pas d'allocation dynamique.
  * Le moteur lui-même est dsp/drum_engine.c (vendored, compilé avec DR_FM1_ECO via ztek_drum_fm1.c). */
 #include <string.h>
+#define DR_FM1_ECO 1                     /* même taille de drum_t que l'unité moteur ztek_drum_fm1.c (sinon .bss x2 et struct mismatch) */
