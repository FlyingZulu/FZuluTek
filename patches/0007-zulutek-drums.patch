diff --git a/atek303/app/ztek_drum.c b/atek303/app/ztek_drum.c
new file mode 100644
index 0000000..f667295
--- /dev/null
+++ b/atek303/app/ztek_drum.c
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_drum.c — glue FM-1 de la drum machine (voir ztek_drum.h). C99, pas d'allocation dynamique.
+ * Le moteur lui-même est dsp/drum_engine.c (vendored, compilé avec DR_FM1_ECO via ztek_drum_fm1.c). */
+#include <string.h>
+#include "ztek_drum.h"
+#include "dsp/drum_engine.h"
+
+static drum_t d;
+static float busL[ZDR_BUS_MAX], busR[ZDR_BUS_MAX];
+static int s_pad, s_ppage, s_playing, s_rec;
+
+static float clamp01(float v) { return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v; }
+
+void zdr_init(float sr)
+{
+    drum_init(&d, sr);
+    s_pad = 0;
+    s_ppage = 0;
+    s_playing = 1;
+    s_rec = 0;
+    d.playing = 1;
+}
+
+void zdr_render(uint32_t n)
+{
+    if (n > ZDR_BUS_MAX) n = ZDR_BUS_MAX;
+    drum_set_bpm(&d, (float)zdr_tempo());
+    d.playing = s_playing;
+    d.rec = s_rec;
+    drum_render(&d, busL, busR, (int)n);
+}
+
+const float *zdr_bus_l(void) { return busL; }
+const float *zdr_bus_r(void) { return busR; }
+
+int zdr_playing(void) { return s_playing; }
+int zdr_sel_pad(void) { return s_pad; }
+
+void zdr_step_toggle(int step)
+{
+    int on, vel, cond, slide;
+    if (step < 0 || step >= DR_NSTEPS) return;
+    drum_get_step(&d, s_pad, step, &on, &vel, &cond, &slide);
+    if (!on && vel == 0) vel = 110;
+    drum_set_step(&d, s_pad, step, !on, vel, cond, slide);
+    zdr_say(DR_PAD_NAMES[s_pad], on ? "OFF" : "ON");
+}
+
+void zdr_pad_hit(int pad)
+{
+    drum_hit(&d, pad);                    /* REC live automatique si d.rec (voir drum_hit) */
+    zdr_say(DR_PAD_NAMES[pad], "HIT");
+}
+
+/* enc: 0 SELECT 1 ALGO 2 PRESET 3..6 K1..K4 (ordre enum app.h) */
+void zdr_encoder(int enc, int32_t det)
+{
+    if (det == 0) return;
+    if (enc == 0) {                       /* SELECT = pad */
+        s_pad += det > 0 ? 1 : -1;
+        if (s_pad < 0) s_pad = DR_NPADS - 1;
+        if (s_pad >= DR_NPADS) s_pad = 0;
+        zdr_say("PAD", DR_PAD_NAMES[s_pad]);
+    } else if (enc == 2) {                /* PRESET = page de params 1/2 */
+        s_ppage = (s_ppage + (det > 0 ? 1 : -1) + 2) % 2;
+        zdr_say("PAGE", s_ppage == 0 ? "1/2 P0-P3" : "2/2 P4-P7");
+    } else if (enc == 1) {                /* ALGO = swing */
+        drum_set_swing(&d, clamp01(d.swing + (det > 0 ? 0.05f : -0.05f)));
+        zdr_say("SWING", d.swing > 0.49f ? "50%" : "0%");
+    } else {                              /* K1..K4 = params de la page courante */
+        int k = enc - 3;
+        int p;
+        float v;
+        if (k < 0 || k > 3) return;
+        p = s_ppage * 4 + k;
+        v = clamp01(d.pad[s_pad].par[p] + (det > 0 ? 0.05f : -0.05f));
+        drum_set_param(&d, s_pad, p, v);
+        zdr_say(DR_PARAM_NAMES[s_pad][p], "");
+    }
+}
+
+void zdr_act_play(void)
+{
+    s_playing = !s_playing;
+    zdr_say("DRUM", s_playing ? "PLAY" : "STOP");
+}
+
+void zdr_act_rec(void)
+{
+    s_rec = !s_rec;
+    zdr_say("REC", s_rec ? "ARMED" : "OFF");
+}
+
+void zdr_act_cond(void)
+{
+    int st = d.play_pos;
+    int on, vel, cond, slide;
+    if (st < 0 || st >= DR_NSTEPS) st = 0;
+    drum_get_step(&d, s_pad, st, &on, &vel, &cond, &slide);
+    cond = (cond + 1) % DR_COND_N;
+    drum_set_step(&d, s_pad, st, on, vel, cond, slide);
+    zdr_say("COND", DR_COND_NAMES[cond]);
+}
+
+void zdr_act_mode(void)
+{
+    int m = (d.pad[s_pad].mode + 1) % DR_MODE_N;
+    drum_set_pad_mode(&d, s_pad, m);
+    zdr_say("MODE", m == DR_MODE_NORM ? "NORM" : m == DR_MODE_REV ? "REV" : "PING-PONG");
+}
+
+void zdr_act_kit(void)
+{
+    static int kit;
+    kit = (kit + 1) % DR_KIT_N;
+    drum_set_kit(&d, kit);
+    zdr_say("KIT", DR_KIT_NAMES[kit]);
+}
+
+void zdr_act_comp(void)
+{
+    int on;
+    float thr, ratio, mk;
+    drum_get_comp(&d, &on, &thr, &ratio, &mk);
+    drum_set_comp(&d, !on, thr, ratio, mk);
+    zdr_say("COMP", on ? "OFF" : "ON");
+}
+
+void zdr_act_rand(void)
+{
+    drum_rand_pat(&d, s_pad, 0.5f, d.rng + 1u);
+    d.rng++;
+    zdr_say(DR_PAD_NAMES[s_pad], "RAND");
+}
+
+void zdr_act_clear(void)
+{
+    drum_clear_pat(&d, s_pad);
+    zdr_say(DR_PAD_NAMES[s_pad], "CLEAR");
+}
diff --git a/atek303/app/ztek_drum.h b/atek303/app/ztek_drum.h
new file mode 100644
index 0000000..448e100
--- /dev/null
+++ b/atek303/app/ztek_drum.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_drum: la drum machine zuluTek (PR #5, module app-zulutek-drums, moteur v2
+ * « PēRKONS-like ») portée sur le firmware FM-1, page DRUM (patch 0007).
+ *
+ * Layout (variante A de la SPEC, retenue) :
+ *   - 16 touches blanches = les 16 steps du pad sélectionné (tap = on/off)
+ *   - 8 premières touches noires = les 8 pads (tap = hit ; REC armé = REC live)
+ *   - encodeurs : SELECT = pad, PRESET = page de params (1/2), ALGO = swing, K1..K4 = P0..P3 de la page
+ *   - boutons : PLAY = transport, REC = REC live, ENV = COND du step courant, LFO = MODE du pad,
+ *               EDIT = kit (ZULU/808/909), SAVE = compresseur on/off, SEQ = RAND du pad, ARP = CLEAR,
+ *               GLO = quitte la page (double-tap GLO depuis ailleurs = page DRUM)
+ * Le bus stéréo du module est mixé en post-FX par app.c (zdr_bus_l/r).
+ *
+ * Le module est découplé d'app.c via les accesseurs zdr_sr/zdr_tempo/zdr_say définis dans app.c. */
+#pragma once
+#include <stdint.h>
+
+#define ZDR_BUS_MAX 256u                 /* APP_BLOCK fm1-base = 256 */
+
+/* ---- fournis par app.c (patch 0007) ---- */
+float zdr_sr(void);
+int   zdr_tempo(void);
+void  zdr_say(const char *a, const char *b);
+
+/* ---- le module ---- */
+void  zdr_init(float sr);
+void  zdr_render(uint32_t n);            /* tout le bloc audio (n <= ZDR_BUS_MAX), remplit le bus */
+const float *zdr_bus_l(void);
+const float *zdr_bus_r(void);
+
+/* page DRUM : actions (app.c route les touches/boutons/encodeurs ici) */
+void  zdr_step_toggle(int step);         /* touche blanche 0..15 : toggle le step du pad sel */
+void  zdr_pad_hit(int pad);              /* touche noire : hit du pad (REC live si armé) */
+void  zdr_encoder(int enc, int32_t det); /* enc = ordre enum app.h : 0 SELECT 1 ALGO 2 PRESET 3..6 K1..K4 */
+void  zdr_act_play(void);                /* PLAY : transport */
+void  zdr_act_rec(void);                 /* REC : REC live on/off */
+void  zdr_act_cond(void);                /* ENV : COND du step courant (Elektron 1:1..FILL) */
+void  zdr_act_mode(void);                /* LFO : mode du pad (NORM/REV/PING-PONG) */
+void  zdr_act_kit(void);                 /* EDIT : kit ZULU/808/909 */
+void  zdr_act_comp(void);                /* SAVE : compresseur de bus on/off */
+void  zdr_act_rand(void);                /* SEQ : RAND du pad sel */
+void  zdr_act_clear(void);               /* ARP : clear du pad sel */
+int   zdr_playing(void);
+int   zdr_sel_pad(void);
