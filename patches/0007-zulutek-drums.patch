+const char *DR_LFO_WAVE_NAMES[DR_LFO_WAVES] = { "SIN", "TRI", "SQ", "SAW", "S&H", "DRUNK" };
+
+/* Règle FlyingZulu : le knob P0 de TOUTES les voies = PITCH (hauteur), comme 808/909/PĒRKONS.
