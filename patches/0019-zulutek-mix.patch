+++ b/atek303/app/ztek_mix.c
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * patch 0011: page MIX — voir ztek_mix.h. Logique seule ici (pas de gfx) : le dessin est
+ * zmix_draw() dans app.c. SEL = tranche/master, K1 = volume (32 crans), K2 = mute.
+ */
+#include "ztek_mix.h"
+#include "app.h"                 /* plat.h (fm1-base) : EN_SELECT, EN_K1, EN_K2 */
+#include "ztek_siren.h"          /* zsir_get/zsir_set : la tranche SIREN = par[3] (SIREN MIX, ZTF) */
+
+const char *const ZMIX_NAME[ZMIX_NSTRIP] = {"VOICE", "DRUMS", "LOOP", "SIREN", "MASTER"};
+
+static int sel;
+
+int  zmix_sel(void) { return sel; }
+void zmix_sel_set(int s) { sel = s < 0 ? 0 : (s >= ZMIX_NSTRIP ? ZMIX_NSTRIP - 1 : s); }
+
+int zmix_vol(int s) { return (s >= 0 && s < ZMIX_NSTRIP) ? zmix_opt_vol(s) : 255; }
+
+static void say_vol(int s, int v)
+{
+    char t[8];
+    t[0] = (char)('0' + (v / 100) % 10);
+    t[1] = (char)('0' + (v / 10) % 10);
+    t[2] = (char)('0' + v % 10);
+    t[3] = '%';
+    t[4] = 0;
+    zmix_say(ZMIX_NAME[s], t);
+}
+
+void zmix_vol_set(int s, int v)
+{
+    if (s < 0 || s >= ZMIX_NSTRIP)
+        return;
+    if (v < 0) v = 0;
+    if (v > 255) v = 255;
+    if (v == zmix_opt_vol(s))
+        return;
+    zmix_opt_set_vol(s, v);              /* SIREN : écrit aussi zsir par[3] (SIREN MIX / ZTF) */
+    say_vol(s, v);
+}
+
+int zmix_muted(int s) { return (s >= 0 && s < ZMIX_NSTRIP) ? ((zmix_opt_mut() >> s) & 1) : 0; }
+
+void zmix_mute_set(int s, int on)
+{
+    int m;
+    if (s < 0 || s >= ZMIX_NSTRIP)
+        return;
+    m = zmix_opt_mut();
+    if (on) m |= 1 << s; else m &= ~(1 << s);
+    if (m == zmix_opt_mut())
+        return;
+    zmix_opt_set_mut(m);
+    zmix_say(ZMIX_NAME[s], on ? "MUTE" : "ON");
+}
+
+void zmix_encoder(int k, int32_t det)
+{
+    if (k == EN_SELECT) {                 /* SEL = tranche / master */
+        int s = sel + (int)det;
+        sel = (s % ZMIX_NSTRIP + ZMIX_NSTRIP) % ZMIX_NSTRIP;
+        zmix_say("MIX", ZMIX_NAME[sel]);
+        return;
+    }
+    if (k == EN_K1) {                     /* K1 = volume, 8/255 par cran */
+        zmix_vol_set(sel, zmix_vol(sel) + 8 * (int)det);
+        return;
+    }
+    if (k == EN_K2 && det) {              /* K2 = mute on/off */
+        zmix_mute_set(sel, !zmix_muted(sel));
+    }
+}
+
+float zmix_voice_f(void) { return zmix_muted(ZMIX_VOICE) ? 0.0f : zmix_vol(ZMIX_VOICE) / 255.0f; }
+float zmix_drum_f(void)  { return zmix_muted(ZMIX_DRUMS) ? 0.0f : zmix_vol(ZMIX_DRUMS) / 255.0f; }
+float zmix_loop_f(void)  { return zmix_muted(ZMIX_LOOP) ? 0.0f : zmix_vol(ZMIX_LOOP) / 255.0f; }
+
+uint32_t zmix_master_q12(uint32_t m)
+{
+    if (zmix_muted(ZMIX_MASTER))
+        return 0;
+    return m * (uint32_t)zmix_vol(ZMIX_MASTER) / 255u;   /* m <= 4096 (q12) : tient en 32 bits, pas de mul 64-bit inline (check build.py) */
+}
