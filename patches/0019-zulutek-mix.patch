@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * patch 0011: page MIX (15) — table de mixage 4 tranches + master, unifiée avec l'APK
+ * (docs/ZULUTEK-MIX-SIREN.md) : VOICE (basse+lead réunis : le bus voix est mono, un seul
+ * engine rend à la fois) / DRUMS / LOOP / SIREN + MASTER. La tranche SIREN pilote le param
+ * SIREN MIX existant (zsir par[3] = OP_SIREN_MIX, exposé en ZTF P_SIREN_MIX) : aucun nouveau
+ * param ZTF. Les volumes des 4 autres tranches + le masque de mute sont persistés dans
+ * OBJ_OPTIONS (OP_MIX_*), jamais dans les presets.
+ *
+ * Navigation : REC maintenu + SAVE = page 15 ; GLO la quitte. SEL = tranche/master,
+ * K1 = vol, K2 = mute ; blanches 0..4 = les 5 lignes. Le dessin (zmix_draw) est dans app.c.
+ */
+#pragma once
+#include <stdint.h>
+
+#define ZMIX_PAGE 15u
+enum { ZMIX_VOICE = 0, ZMIX_DRUMS, ZMIX_LOOP, ZMIX_SIREN, ZMIX_MASTER, ZMIX_NSTRIP };
+extern const char *const ZMIX_NAME[ZMIX_NSTRIP];
+
+int  zmix_sel(void);
+void zmix_sel_set(int s);
+int  zmix_vol(int s);                    /* 0..255 (SIREN = zsir par[3]) */
+void zmix_vol_set(int s, int v);
+int  zmix_muted(int s);
+void zmix_mute_set(int s, int on);
+void zmix_encoder(int k, int32_t det);  /* EN_* sur la page MIX : SEL=tranche, K1=vol, K2=mute */
+
+float    zmix_voice_f(void);             /* facteurs appliqués dans app_render */
+float    zmix_drum_f(void);
+float    zmix_loop_f(void);
+uint32_t zmix_master_q12(uint32_t m);
+
+/* ---- provided by app.c (patch 0011) ---- */
+int  zmix_opt_vol(int s);                /* SIREN -> zsir_get(3), sinon opt.v[OP_MIX_VOL0+slot] */
+void zmix_opt_set_vol(int s, int v);     /* opt.v + zsir_set(3) + save OBJ_OPTIONS (throttlé) */
+int  zmix_opt_mut(void);                 /* opt.v[OP_MIX_MUT] bitmask */
+void zmix_opt_set_mut(int mask);
+void zmix_say(const char *a, const char *b);
