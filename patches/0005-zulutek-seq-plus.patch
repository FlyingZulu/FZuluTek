index 0000000..e6a8e8b
--- /dev/null
+++ b/atek303/app/ztek_seqplus.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_seqplus: the SEQ+ pack (FZuluTek PR #3) ported to the FM-1 firmware, on top of the
+ * ATEK303 app (patch 0005). Same feature set as the APK preview, minus what the hardware
+ * cannot do (no touch XY pad here):
+ *   - SEQ advanced sub-mode (double-tap SEQ): TM LOCK / TM LEN / MUT / PLAY (NORM REV
+ *     PING-PONG) / RAND; the Turing Machine rotates the pattern window at each loop wrap.
+ *   - mutation live already wired by the ATEK303 (ENV/LFO/ARP -> EV_MUTATE); the MUT knob
+ *     sets the burst size (zsp_mutate_ops).
+ *   - modulation 8/8, per CHUNK (32 samples) so the cost is negligible on the AC791N:
+ *     page LFO = 4 LFO (SIN TRI SQ SAW S&H DRUNK, SYNC/TRIG) + 4 labos (8 types);
+ *     page ENV = ENV1/ENV2 loopable + EF LOG SLEW CMP QUANT ATT; page ASSIGN = typed matrix
+ *     out->in (16 sources -> 35 destinations: voice, FX, seq), no feedback cycles.
+ *   - option LUDIQUE (OPTIONS): the educational pops (no-entry sign + suggestions).
+ *   - presets per part: the existing 32 presets get a part tag (BASSE/LEAD/DRUMS, in the
+ *     high bits of preset_t.used), and the modulation state is kept per part in flash
+ *     (OBJ_ZSEQ).
+ *
+ * The module is decoupled from app.c through the zsp_* accessors the patch defines there. */
+#pragma once
+#include <stdint.h>
+#include "dsp/atek_voice.h"
+#include "dsp/fx.h"
+#include "dsp/acid_pattern.h"
+
+/* ---- provided by app.c (patch 0005) ---------------------------------------------- */
+float *zsp_at_params(void);                 /* set.param */
+float *zsp_fx_params(void);                 /* set.fx */
+acid_pattern_t *zsp_pattern(void);          /* &set.pattern */
+acid_grid_t *zsp_grid(void);                /* &sq.grid */
+float zsp_seqk0(int k);                     /* set.seqk[k], the 6 base knobs */
+void zsp_at_set(int k, float v);
+void zsp_fx_set(int k, float v);
+int  zsp_seq_len(void);
+void zsp_set_tempo(int bpm);
+int  zsp_tempo(void);
+void zsp_set_root(int r);
+void zsp_set_scale(int s);
+void zsp_regrow(void);                      /* regenerate the pattern from the knobs */
+int  zsp_scale(void);
+
+/* ---- sequencer advanced ---------------------------------------------------------- */
