new file mode 100644
index 0000000..20ae092
--- /dev/null
+++ b/atek303/app/ztek_seqplus.c
@@ -0,0 +1,517 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_seqplus.c — see ztek_seqplus.h. The modulation runs per CHUNK (32 samples), never per
+ * sample, so 4 LFOs + 4 labos + 2 ENVs + 6 tools + the matrix cost a handful of µs per chunk
+ * on the AC791N: negligible next to the voice and the FX which run per sample. */
+#include "ztek_seqplus.h"
+#include "app.h"                 /* OBJ_ZSEQ, plat_store_* */
+#include "dsp/fastmath.h"
+#include <string.h>
+
+#define ZSP_MAGIC 0x5A535031u          /* 'ZSP1' */
+
+typedef struct {
+    float mod_knob[ZSP_NSRC][4];
+    int   lab_type[4];
+    int   lab_src[4][2];
+    int   lfo_sync, lfo_trig;
+    int   env_loop[2];
+    int   asg_src[ZSP_NDST];
+    float asg_depth[ZSP_NDST];
+    float seqk5[ZSP_NSEQK];
+} zsp_modstate_t;
+
+typedef struct {
+    uint32_t magic;
+    uint8_t ludique;
+    zsp_modstate_t cur;
+    zsp_modstate_t by_part[3];
+} zsp_flash_t;
+
+static zsp_flash_t zf;
+static zsp_modstate_t *M = &zf.cur;     /* the live mod state */
+
+/* runtime (not persisted) */
+static float src_val[ZSP_NSRC];
+static float lfo_ph[4], lfo_sh[4], lfo_drunk[4];
+static float lab_out[4];
+static float lab_bird[4][2][16];
+static int   lab_birdpos[4][2];
+static uint32_t lab_rng[4];
+static int   lab_clk[4];
+static float lab_phase[4];
+static float env_ph[2], env_lvl[2];
+static int   env_loop[2], env_stage[2];
+static float ef_lvl, blk_peak, tool_state[6];
+static float dst_base[ZSP_NDST];
+static int   play_pos, play_dir;
+static uint32_t rng_ = 0x9e3779b9u;
+
+static uint32_t lcg(void) { rng_ = rng_ * 1103515245u + 12345u; return rng_; }
+static float rnd01(void) { return (float)(lcg() >> 8) / 16777216.0f; }
+
+/* ---- accessors to app.c's state --------------------------------------------------- */
+void  zsp_set_seqk(int k, float v) { if (k >= 0 && k < ZSP_NSEQK) M->seqk5[k] = v < 0 ? 0 : v > 1 ? 1 : v; }
+float zsp_seqk(int k) { return (k >= 0 && k < ZSP_NSEQK) ? M->seqk5[k] : 0.0f; }
+int   zsp_mutate_ops(void) { return 1 + (int)(M->seqk5[ZSP_MUT] * 7.0f); }
+int   zsp_ludique(void) { return zf.ludique; }
+void  zsp_set_ludique(int on) { zf.ludique = on ? 1 : 0; }
+
+/* ---- sequencer: play modes + Turing Machine at the wrap --------------------------- */
+int zsp_advance(int len, int cur, int *wrapped)
+{
+    int mode = M->seqk5[ZSP_PLAY] < 0.34f ? 0 : (M->seqk5[ZSP_PLAY] < 0.67f ? 1 : 2);
+    int next = cur, w = 0;
+    if (mode == 0) {
+        next = cur + 1;
+        if (next >= len) { next = 0; w = 1; }
+    } else if (mode == 1) {
+        next = cur - 1;
+        if (next < 0) { next = len - 1; w = 1; }
+    } else {
+        next = cur + play_dir;
+        if (next >= len) { next = len - 2; if (next < 0) next = 0; play_dir = -1; w = 1; }
+        else if (next < 0) { next = 1; if (next >= len) next = len - 1; play_dir = 1; w = 1; }
+    }
+    *wrapped = w;
+    return next;
+}
+
+void zsp_wrap(void)
+{
+    acid_pattern_t *pat = zsp_pattern();
+    int steps = pat->time_length;
+    if (steps < 1) steps = 1;
+    if (steps > ACID_MAX_STEPS) steps = ACID_MAX_STEPS;
+
+    /* RAND: full re-generation with a probability at each loop wrap */
+    if (M->seqk5[ZSP_RAND] > 0.0001f && rnd01() < M->seqk5[ZSP_RAND]) {
+        acid_params_t p;
+        acid_params_default(&p);
+        p.scale = zsp_scale();
+        acid_generate(pat, &p, lcg());
+        return;
+    }
+
+    /* Turing Machine: rotate the window [0, wl) right; the new head is kept when
+     * r < lock, mutated when lock <= r < lock+mut, re-rolled otherwise. lock=0 -> TM off. */
+    float lock = M->seqk5[ZSP_TMLOCK];
+    if (lock > 0.0001f) {
+        acid_grid_t *g = zsp_grid();
+        int wl = (int)(M->seqk5[ZSP_TMLEN] * 60.0f + 4.0f);
+        if (wl < 4) wl = 4;
+        if (wl > steps) wl = steps;
+        acid_grid_t t = *g;
+        int8_t tdeg = t.deg[wl-1]; int8_t toct = t.oct[wl-1];
+        uint8_t tg = t.gate[wl-1], ta = t.accent[wl-1], ts = t.slide[wl-1], tt = t.tie[wl-1];
+        int i;
+        for (i = wl - 1; i > 0; i--) {
+            t.deg[i] = t.deg[i-1]; t.oct[i] = t.oct[i-1];
+            t.gate[i] = t.gate[i-1]; t.accent[i] = t.accent[i-1];
+            t.slide[i] = t.slide[i-1]; t.tie[i] = t.tie[i-1];
+        }
+        float r = rnd01();
+        t.deg[0] = tdeg; t.oct[0] = toct; t.gate[0] = tg;
+        t.accent[0] = ta; t.slide[0] = ts; t.tie[0] = tt;
+        if (r >= lock) {
+            if (r < lock + M->seqk5[ZSP_MUT]) {
+                uint32_t m = lcg() & 3u;
+                if (m == 0) t.deg[0] += (lcg() & 1u) ? 1 : -1;
+                else if (m == 1) t.oct[0] += (lcg() & 1u) ? 1 : -1;
+                else if (m == 2) t.gate[0] = t.gate[0] ? 0 : 1;
+                else t.accent[0] = t.accent[0] ? 0 : 1;
+            } else {
+                t.gate[0] = (lcg() % 100u) < 70u ? 1 : 0;
+                t.deg[0] = (int8_t)((int)(lcg() % 12u) - 6);
+                t.oct[0] = (int8_t)((int)(lcg() % 3u) - 1);
+                t.accent[0] = (lcg() % 100u) < 30u ? 1 : 0;
+                t.slide[0] = 0; t.tie[0] = 0;
+            }
+        }
+        *g = t;
+        acid_import(pat, g, steps, pat->seed, pat->algorithm_version);
+        acid_render(pat, g);
+    }
+}
+
+/* ---- modulation, per CHUNK -------------------------------------------------------- */
+static float zsp_wave(int w, float ph)
+{
+    float p = ph - fm_floorf(ph);
+    switch (w) {
+    case 1:  return p < 0.5f ? p * 2.0f : 2.0f - p * 2.0f;
+    case 2:  return p < 0.5f ? 1.0f : 0.0f;
+    case 3:  return p;
+    default: return 0.5f + 0.5f * fm_sin_turns(p);
+    }
+}
+
+static void lfo_block(float dt)
+{
+    static const float DIVS[6] = { 16.f, 8.f, 4.f, 2.f, 1.f, 0.5f };
+    int i;
+    for (i = 0; i < 4; i++) {
+        float rate = M->mod_knob[i][0];
+        float hz = M->lfo_sync ? (zsp_tempo() / 60.0f) / DIVS[(int)(rate * 5.99f) > 5 ? 5 : (int)(rate * 5.99f)]
+                               : 0.02f + rate * rate * 40.0f;
+        float ph = lfo_ph[i] + hz * dt;
+        int w = (int)(M->mod_knob[i][1] * 5.99f);
+        if (w > 5) w = 5;
+        if (ph >= 1.0f) {
+            ph -= fm_floorf(ph);
+            if (w == 4) lfo_sh[i] = rnd01();
+        }
+        lfo_ph[i] = ph;
+        float v;
+        if (w == 4) v = lfo_sh[i];
+        else if (w == 5) {
+            lfo_drunk[i] += (rnd01() - 0.5f) * 0.25f;
+            lfo_drunk[i] = fm_clampf(lfo_drunk[i], 0.0f, 1.0f);
+            v = lfo_drunk[i];
+        } else {
+            v = zsp_wave(w, ph);
+            if (w == 2) {
+                float p = ph - fm_floorf(ph);
+                v = p < (0.2f + M->mod_knob[i][3] * 0.6f) ? 1.0f : 0.0f;
+            }
+        }
+        float amp = M->mod_knob[i][2] * 2.0f;
+        if (amp > 2.0f) amp = 2.0f;
+        src_val[i] = fm_clampf(0.5f + (v - 0.5f) * amp, 0.0f, 1.0f);
+    }
+}
+
+static void env_block(float dt)
+{
+    int e;
+    for (e = 0; e < 2; e++) {
+        float A = 0.005f + M->mod_knob[8 + e][0] * 0.5f;
+        float D = 0.005f + M->mod_knob[8 + e][1] * 0.5f;
+        float S = M->mod_knob[8 + e][2];
+        float R = 0.005f + M->mod_knob[8 + e][3] * 1.0f;
+        if (A < 1e-4f) A = 1e-4f;
+        if (D < 1e-4f) D = 1e-4f;
+        if (R < 1e-4f) R = 1e-4f;
+        int st = env_stage[e];
+        float lvl = env_lvl[e], ph = env_ph[e];
+        switch (st) {
+        case 0: lvl += dt / A; if (lvl >= 1.0f) { lvl = 1.0f; st = 1; } break;
+        case 1: lvl -= dt / D * (1.0f - S); if (lvl <= S) { lvl = S; st = 2; } break;
+        case 2: ph += dt / R; if (ph >= 1.0f) { ph = 0.0f; st = 3; } break;
+        default: lvl -= dt / R; if (lvl <= 0.0f) { lvl = 0.0f; if (env_loop[e]) st = 0; } break;
+        }
+        env_stage[e] = st; env_lvl[e] = lvl; env_ph[e] = ph;
+        src_val[8 + e] = lvl;
+    }
+}
+
+static void lab_block(void)
+{
+    int i;
+    for (i = 0; i < 4; i++) {
+        int type = M->lab_type[i];
+        int s1 = M->lab_src[i][0], s2 = M->lab_src[i][1];
+        float a = (s1 >= 0 && s1 < 4 + i) ? src_val[s1] : 0.5f;
+        float b = (s2 >= 0 && s2 < 4 + i) ? src_val[s2] : 0.5f;
+        float depth = M->mod_knob[4 + i][3];
+        lab_rng[i] = lab_rng[i] * 1103515245u + 12345u;
+        float jit = ((float)(lab_rng[i] >> 8) / 16777216.0f - 0.5f) * 2.0f;
+        int clk = lab_clk[i]++;
+        float out;
+        switch (type) {
+        case 1:  out = a + (b - 0.5f) * 0.5f + jit * 0.12f; break;
+        case 2:  out = a + (b - 0.5f) * 0.3f + jit * 0.04f; break;
+        case 3: {
+            out = a + jit * 0.45f + (b - 0.5f) * 0.2f;
+            float st = 0.5f - 0.5f * 0.42f;
+            out = fm_floorf(out / st + 0.5f) * st;
+            break;
+        }
+        case 4:  out = a + jit * 0.85f + (b - 0.5f) * 1.6f; break;
+        case 5: {
+            if ((clk & 7) == 0) {
+                lab_bird[i][0][lab_birdpos[i][0]] = a;
+                lab_birdpos[i][0] = (lab_birdpos[i][0] + 1) & 15;
+                lab_bird[i][1][lab_birdpos[i][1]] = b;
+                lab_birdpos[i][1] = (lab_birdpos[i][1] + 1) & 15;
+            }
+            float bird = lab_bird[i][1][(lab_birdpos[i][1] - 8 + 16) & 15];
+            out = a + (bird - 0.5f) * 0.9f + jit * 0.1f;
+            break;
+        }
+        case 6: {
+            out = a;
+            if ((clk % 8) == 0) out += jit * 0.5f;
+            if ((clk / 3) & 1) out += (b - 0.5f) * 0.3f;
+            break;
+        }
+        case 7: {
+            lab_phase[i] += 32.0f / (44100.0f * 9.0f);
+            if (lab_phase[i] >= 1.0f) lab_phase[i] -= 1.0f;
+            out = a + (fm_sin_turns(lab_phase[i]) * 0.5f + 0.5f) * 0.4f + (b - 0.5f) * 0.2f;
+            break;
+        }
+        default: out = a + (b - 0.5f); break;
+        }
+        float amp = 0.3f + depth * 1.7f;
+        lab_out[i] = fm_clampf(0.5f + (fm_clampf(out, 0.0f, 1.0f) - 0.5f) * amp, 0.0f, 1.0f);
+        src_val[4 + i] = lab_out[i];
+    }
+}
+
+static float tool_src(int tool)
+{
+    int s = (int)(M->mod_knob[tool][0] * 16.999f);
+    if (s >= ZSP_NSRC) return 0.0f;
+    if (s >= tool) s = 0;
+    return src_val[s];
+}
+
+static void tool_block(float dt)
+{
+    int t;
+    for (t = 0; t < 6; t++) {
+        int src = 10 + t;
+        float in = tool_src(src);
+        float p1 = M->mod_knob[src][1], p2 = M->mod_knob[src][2], depth = M->mod_knob[src][3];
+        float out = in;
+        switch (t) {
+        case 0: {
+            float k = blk_peak > ef_lvl ? (0.01f + p1 * 2.0f) : (0.001f + p2 * 0.5f);
+            ef_lvl += (blk_peak - ef_lvl) * k;
+            out = ef_lvl * (0.2f + p1 * 4.0f);
+            break;
+        }
+        case 1:
+            { float x = 1.0f + in * 9.0f; out = (x - 1.0f) / (1.0f + 0.5f * (x - 1.0f)); }  /* ln approx (Pade), no libm */
+            out = out * (0.2f + p1 * 2.0f) + p2;
+            break;
+        case 2: {
+            float st = tool_state[t];
+            float step = (0.0005f + (in > st ? p1 : p2) * (in > st ? p1 : p2) * 4.0f) * dt * 60.0f;
+            if (in > st) { st += step; if (st > in) st = in; }
+            else { st -= step; if (st < in) st = in; }
+            tool_state[t] = st;
+            out = st;
+            break;
+        }
+        case 3: {
+            float th = p1, hy = 0.02f + p2 * 0.2f, st = tool_state[t];
+            if (in > th + hy) st = 1.0f;
+            else if (in < th - hy) st = 0.0f;
+            tool_state[t] = st;
+            out = st;
+            break;
+        }
+        case 4: {
+            int steps = 2 + (int)(p1 * 30.0f);
+            out = fm_floorf(in * steps + 0.5f) / steps + p2 * 0.1f;
+            break;
+        }
+        default:
+            out = in * p1 + p2 * 0.5f;
+            break;
+        }
+        out = out * depth + in * (1.0f - depth);
+        src_val[src] = fm_clampf(out, 0.0f, 1.0f);
+    }
+}
+
+static void matrix_block(void)
+{
+    int d;
+    for (d = 0; d < ZSP_NDST; d++) {
+        int s = M->asg_src[d];
+        float depth = M->asg_depth[d];
+        float v;
+        if (s < 0 || s >= ZSP_NSRC || depth <= 0.0001f) continue;
+        v = fm_clampf(dst_base[d] + (src_val[s] - 0.5f) * 2.0f * depth, 0.0f, 1.0f);
+        if (d < AT_NPARAMS) zsp_at_set(d, v);
+        else if (d < ZSP_SEQ_DST0) zsp_fx_set(d - AT_NPARAMS, v);
+        else {
+            int k = d - ZSP_SEQ_DST0;
+            if (k == 0) { /* steps: sanitize+render via the grid */ }
+            else if (k == 1) zsp_set_scale((int)(v * 7.99f));
+            else if (k == 2) zsp_set_tempo((int)(v * 300.0f));
+            else if (k == 3) zsp_set_root(24 + (int)(v * 48.99f));
+            else M->seqk5[k - 4] = v;
+        }
+    }
+}
+
+void zsp_mod_chunk(uint32_t n, float dt)
+{
+    (void)n;
+    lfo_block(dt);
+    lab_block();
+    env_block(dt);
+    tool_block(dt);
+    matrix_block();
+}
+
+void zsp_mod_init(void)
+{
+    int s, k, d;
+    memset(&zf, 0, sizeof zf);
+    M = &zf.cur;
+    for (s = 0; s < ZSP_NSRC; s++) {
+        src_val[s] = 0.0f;
+        for (k = 0; k < 4; k++) M->mod_knob[s][k] = 0.5f;
+    }
+    M->mod_knob[0][0] = 0.35f;
+    for (d = 0; d < ZSP_NDST; d++) { M->asg_src[d] = 255; M->asg_depth[d] = 0.0f; dst_base[d] = 0.5f; }
+    for (d = 0; d < AT_NPARAMS; d++) dst_base[d] = zsp_at_params()[d];
+    for (d = 0; d < FX_NPARAMS; d++) dst_base[8 + d] = zsp_fx_params()[d];
+    for (k = 0; k < ZSP_NSEQK; k++) M->seqk5[k] = 0.0f;
+    zf.ludique = 1;
+    zf.magic = ZSP_MAGIC;
+}
+
+/* knob setters */
+void zsp_mod_knob(int src, int k, float v)
+{
+    if (src < 0 || src >= ZSP_NSRC || k < 0 || k > 3) return;
+    if (v < 0.0f) v = 0.0f;
+    if (v > 1.0f) v = 1.0f;
+    M->mod_knob[src][k] = v;
+    if (src >= 4 && src < 8) {
+        if (k == 0) M->lab_type[src - 4] = (int)(v * 7.99f);
+        else if (k == 1) M->lab_src[src - 4][0] = (int)(v * 16.999f) == 16 ? -1 : (int)(v * 15.99f);
+        else if (k == 2) M->lab_src[src - 4][1] = (int)(v * 16.999f) == 16 ? -1 : (int)(v * 15.99f);
+    }
+}
+float zsp_mod_knob_get(int src, int k)
+{
+    if (src < 0 || src >= ZSP_NSRC || k < 0 || k > 3) return 0.0f;
+    return M->mod_knob[src][k];
+}
+void zsp_lfo_opt(int which, int on)
+{
+    if (which == 0) M->lfo_sync = on ? 1 : 0;
+    else if (which == 1) M->lfo_trig = on ? 1 : 0;
+}
+void zsp_env_loop(int e, int on)
+{
+    if (e >= 0 && e < 2) { M->env_loop[e] = on ? 1 : 0; env_loop[e] = M->env_loop[e]; }
+}
+float zsp_src_val(int src) { return (src >= 0 && src < ZSP_NSRC) ? src_val[src] : 0.0f; }
+void zsp_assign(int dst, int src, float depth)
+{
+    if (dst < 0 || dst >= ZSP_NDST) return;
+    M->asg_src[dst] = src;
+    M->asg_depth[dst] = fm_clampf(depth, 0.0f, 1.0f);
+}
+int   zsp_assign_src(int dst) { return (dst >= 0 && dst < ZSP_NDST) ? M->asg_src[dst] : 255; }
+float zsp_assign_depth(int dst) { return (dst >= 0 && dst < ZSP_NDST) ? M->asg_depth[dst] : 0.0f; }
+
+/* knob routing for pages 8 (LFO), 9 (ENV), 10 (ASSIGN); enc = 0..6 (SEL PRE ALG K1..K4) */
+static float page_val[11][7];
+void zsp_page_turn(int page, int enc, int32_t det)
+{
+    float v;
+    int sub;
+    if (page < 8 || page > 10 || enc < 0 || enc > 6) return;
+    v = fm_clampf(page_val[page][enc] + (float)det * 0.02f, 0.0f, 1.0f);
+    page_val[page][enc] = v;
+    if (page == 8) {                       /* LFO: SEL=sub PRE=SYNC ALG=TRIG K1..K4=knobs */
+        if (enc == 1) zsp_lfo_opt(0, v > 0.5f);
+        else if (enc == 2) zsp_lfo_opt(1, v > 0.5f);
+        else if (enc >= 3) {
+            sub = (int)(page_val[8][0] * 7.99f);
+            if (sub >= 4 && (enc == 4 || enc == 5)) {
+                float mx = (sub - 1) / 16.999f;
+                if (v > mx) v = mx;         /* no feedback cycles (VCV-style typed patch) */
+            }
+            zsp_mod_knob(sub, enc - 3, v);
+        }
+    } else if (page == 9) {                /* ENV: SEL=sub PRE=loop K1..K4=knobs */
+        if (enc == 1) {
+            sub = (int)(page_val[9][0] * 7.99f);
+            if (sub < 2) zsp_env_loop(sub, v > 0.5f);
+        } else if (enc >= 3) {
+            sub = (int)(page_val[9][0] * 7.99f);
+            if (sub >= 2 && enc == 3) {
+                float mx = (7 + sub) / 16.999f;
+                if (v > mx) v = mx;
+            }
+            zsp_mod_knob(8 + sub, enc - 3, v);
+        }
+    } else if (page == 10) {               /* ASSIGN: SEL=dst PRE=src ALG=LUDIQUE K1=depth */
+        sub = (int)(page_val[10][0] * (ZSP_NDST - 0.001f));
+        if (enc == 1) zsp_assign(sub, (int)(v * 16.999f) == 16 ? 255 : (int)(v * 15.99f), M->asg_depth[sub]);
+        else if (enc == 2) zsp_set_ludique(v > 0.5f);
+        else if (enc == 3) zsp_assign(sub, M->asg_src[sub], v);
+    }
+}
+
+/* SEQ advanced page (double-tap SEQ): detents on the seqk knobs; enc SEL = RAND */
+void zsp_seqk_turn(int k, int32_t det)
+{
+    if (k < 0 || k >= ZSP_NSEQK) return;
+    zsp_set_seqk(k, fm_clampf(M->seqk5[k] + (float)det * 0.02f, 0.0f, 1.0f));
+}
+
+void zsp_set_peak(float p) { blk_peak = p; }
+
+void zsp_note_retrig(void)                 /* LFO TRIG: on each note */
+{
+    int i;
+    if (!M->lfo_trig) return;
+    for (i = 0; i < 4; i++) { lfo_ph[i] = 0.0f; lfo_sh[i] = 0.0f; }
+    for (i = 0; i < 2; i++) { env_ph[i] = 0.0f; env_stage[i] = 0; }
+}
+
+/* ---- persistence (OBJ_ZSEQ) ------------------------------------------------------- */
+#define ZSP_OBJ OBJ_ZSEQ
+
+void zsp_flash_load(void)
+{
+    zsp_mod_init();
+    if (plat_store_load(ZSP_OBJ, &zf, (int)sizeof zf) == (int)sizeof zf && zf.magic == ZSP_MAGIC)
+        M = &zf.cur;
+    else {
+        zf.magic = ZSP_MAGIC;
+        zf.ludique = 1;
+        M = &zf.cur;
+    }
+    memcpy(env_loop, M->env_loop, sizeof env_loop);
+}
+
+void zsp_flash_save(void)
+{
+    zf.magic = ZSP_MAGIC;
+    memcpy(zf.cur.mod_knob, M->mod_knob, sizeof zf.cur.mod_knob);  /* M == &zf.cur already */
+    plat_store_save(ZSP_OBJ, &zf, (int)sizeof zf);
+}
+
+void zsp_mod_save_part(int part)
+{
+    if (part < 0 || part > 2) return;
+    zf.by_part[part] = zf.cur;
+    zsp_flash_save();
+}
+
+int zsp_mod_load_part(int part)
+{
+    if (part < 0 || part > 2) return 0;
+    zf.cur = zf.by_part[part];
+    M = &zf.cur;
+    memcpy(env_loop, M->env_loop, sizeof env_loop);
+    return 1;
+}
+
+/* preset part tag: high bits of preset_t.used (1 = used) — accessors defined in app.c */
+extern int  app_preset_used_raw(int slot);
+extern void app_preset_set_used_raw(int slot, int raw);
+void zsp_preset_set_part(int slot, int part)
+{
+    int u = app_preset_used_raw(slot);
+    if (!u) return;
+    app_preset_set_used_raw(slot, 1 | ((part & 3) << 1));
+}
+int zsp_preset_part(int slot)
+{
+    int u = app_preset_used_raw(slot);
+    return u ? (u >> 1) & 3 : 0;
+}
diff --git a/atek303/app/ztek_seqplus.h b/atek303/app/ztek_seqplus.h
