{"path":"/home/user/tool-results/fw/patches/0025-zulutek-flashloop.patch","content":"diff --git a/atek303/app/dsp/ztek_flashloop.h b/atek303/app/dsp/ztek_flashloop.h\nnew file mode 100644\nindex 0000000..f5fcef3b03a81b0c0ba67d72e0ba65946db52c60\n--- /dev/null\n+++ b/atek303/app/dsp/ztek_flashloop.h\n@@ -0,0 +1,98 @@\n+/*\n+ * ztek_flashloop.h — loop audio live en flash (patch 0025, FlyingZulu, GPL-3.0).\n+ * Capture le bus interne (pré-Master) et le stocke en flash, mono µ-law 12 kHz\n+ * (8 s = 96 Ko dans la zone 0x97000..0xB0000 = 100 Ko, hors app et hors ZTF,\n+ * voir docs/FM1-FLASHMAP.md). Rejoue la boucle comme un slot du looper :\n+ * pitch ±12 st, one-shot (arrêt au wrap, liaison 0023), grille gate/stutter\n+ * 16 steps façon KP3 (PASS / MUTE figée / REV arrière), choke côté intégration.\n+ * La zone est pré-effacée à la confirmation du REC (fl_erase_step, UN secteur\n+ * 4 Ko par appel, jamais pendant l'audio) ; la capture écrit des pages de\n+ * 256 octets ; la lecture streame en double-tampon RAM (2 x 256 octets).\n+ * Le FM-1 fournit les primitives flash via fl_plat_* ; le host des copies RAM.\n+ */\n+#ifndef ZTEK_FLASHLOOP_H\n+#define ZTEK_FLASHLOOP_H\n+\n+#include <stdint.h>\n+\n+/* zone flash : entre la fin de l'app (0x97000) et la zone ZTF (0xB0000) — 100 Ko */\n+#define FL_BASE      0x97000u\n+#define FL_END       0xB0000u\n+#define FL_SECTOR    0x1000u\n+#define FL_PAGE      256u\n+#define FL_AUD       (FL_BASE + FL_PAGE)               /* le header tient la 1re page */\n+#define FL_CAP       ((FL_END - FL_AUD) & ~0xFFu)       /* 102144 o = 8,51 s à 12 kHz */\n+#define FL_RATE      12000.0f                           /* ring rate mono µ-law */\n+#define FL_NLOOP_MAX 2                                  /* 1 x 8 s ou 2 x 4 s */\n+\n+/* états */\n+enum { FL_OFF = 0, FL_ERASE, FL_ARMED, FL_REC, FL_PLAY, FL_ONESHOT_STOP };\n+enum { FL_OK = 0, FL_BUSY = 1, FL_ERR_STATE = -1, FL_ERR_ZONE = -2, FL_ERR_DATA = -3, FL_ERR_FULL = -4 };\n+\n+/* pas de la grille gate 16 steps (une mesure) : 0 = PASS, 1 = MUTE (figée-silencieuse), 2 = REV */\n+#define FL_GATE_PASS 0\n+#define FL_GATE_MUTE 1\n+#define FL_GATE_REV  2\n+\n+typedef struct {\n+    float    sr;                      /* sample rate moteur (44100) */\n+    int      state;\n+    int      nloops;                  /* 1 ou 2, choisi à l'armement */\n+    int      cur;                     /* boucle en cours de capture */\n+    uint32_t rec_cap;                 /* capacité d'une boucle (octets, multiple page) */\n+    uint32_t rec_pos;                 /* octets écrits dans la boucle courante */\n+    uint8_t  page[FL_PAGE];           /* tampon page */\n+    uint32_t page_len;\n+    uint32_t wphase;                  /* décimateur 16.16 */\n+    float    wlp;                     /* passe-bas avant décimation */\n+    uint32_t erase_next;              /* prochain secteur 4 Ko à effacer */\n+    /* lecture */\n+    int      play_idx;                /* boucle jouée */\n+    int      playing;\n+    int      oneshot;\n+    uint8_t  gate[16];\n+    float    pitch;                   /* -12..+12 demi-tons */\n+    double   rpos;                    /* tête de lecture (échantillons ring) */\n+    int      rdir;\n+    uint32_t rpage;                   /* page du tampon 1 (FF.. = vide) */\n+    uint32_t rpage2;\n+    uint8_t  rbuf[FL_PAGE], rbuf2[FL_PAGE];\n+    uint8_t  rvalid, rvalid2;\n+    float    ramp;                    /* declick 0..1 */\n+    float    hp;                      /* coupe-bas de sortie (état) */\n+    uint32_t len_bytes[FL_NLOOP_MAX]; /* longueurs stockées (octets, RAM copie du header) */\n+    uint32_t base_bytes[FL_NLOOP_MAX];/* début flash de chaque boucle (offset depuis FL_AUD) */\n+} fl_t;\n+\n+/* hooks flash : fournis par la plateforme (FM-1 : SPI flash ; host : copies RAM) */\n+int fl_plat_erase(uint32_t addr);                       /* efface un secteur 4 Ko */\n+int fl_plat_write(uint32_t addr, const uint8_t *buf);  /* écrit une page 256 o */\n+int fl_plat_read(uint32_t addr, uint8_t *buf, uint32_t n);\n+\n+void fl_init(fl_t *f, float sr);\n+\n+/* armement : fl_rec_arm (après le message préventif validé) lance l'effacement\n+ * progressif ; fl_erase_step efface UN secteur par appel (boucle UI) jusqu'à\n+ * FL_OK ; fl_rec_begin commence la prise ; fl_rec_feed reçoit le bus pré-Master\n+ * (mono, n <= 1024) ; fl_rec_end ferme la prise : longueur conservée quantifiée\n+ * aux beats (couture parfaite au wrap, même table que ml_quantize). */\n+int  fl_rec_arm(fl_t *f, int nloops);\n+int  fl_erase_step(fl_t *f);\n+int  fl_rec_begin(fl_t *f);\n+int  fl_rec_feed(fl_t *f, const float *bus, uint32_t n);\n+int  fl_rec_end(fl_t *f, float bpm);\n+\n+/* lecture */\n+int  fl_play(fl_t *f, int idx);\n+void fl_stop(fl_t *f);\n+void fl_set_oneshot(fl_t *f, int on);\n+int  fl_get_oneshot(const fl_t *f);\n+void fl_set_pitch(fl_t *f, float semis);\n+void fl_set_gate(fl_t *f, int step, int g);\n+\n+/* rendu : ajoute la boucle dans out[0..n) ; bus_clk64 = position 1/64 de mesure\n+ * de l'horloge looper (grille gate). Retour FL_ONESHOT_STOP quand une boucle\n+ * one-shot atteint le wrap. Thread audio uniquement. */\n+int fl_render(fl_t *f, float *out, uint32_t n, float bus_clk64);\n+\n+#endif\ndiff --git a/atek303/app/dsp/ztek_flashloop.c b/atek303/app/dsp/ztek_flashloop.c\nnew file mode 100644\nindex 0000000..e3d9d3a15ef4aad4ed9d5065d58552ce6e448738\n--- /dev/null\n+++ b/atek303/app/dsp/ztek_flashloop.c\n@@ -0,0 +1,323 @@\n+/*\n+ * ztek_flashloop.c — loop audio live en flash (patch 0025, FlyingZulu, GPL-3.0).\n+ * Voir ztek_flashloop.h. C99, autonome : µ-law local (même companding que\n+ * dsp/midi_looper.c), décimation par phase 16.16, double-tampon page.\n+ */\n+#include \"ztek_flashloop.h\"\n+\n+/* ---- µ-law (G.711, identique midi_looper.c : bias 0x84, ~13 bits) --------- */\n+static uint8_t fl_ulaw_enc(float x)\n+{\n+    int sign, exp, mant, sample, mask;\n+    if (x < 0.0f) { sign = 0x80; x = -x; } else sign = 0;\n+    if (x > 1.0f) x = 1.0f;\n+    sample = (int)(x * 32768.0f) + 0x84;              /* bias */\n+    exp = 7; mask = 0x4000;\n+    while (exp > 0 && !(sample & mask)) { mask >>= 1; exp--; }\n+    mant = (sample >> (exp + 3)) & 0x0F;\n+    return (uint8_t)~(sign | (exp << 4) | mant);\n+}\n+static float fl_ulaw_dec(uint8_t u)\n+{\n+    int t, sample;\n+    u = (uint8_t)~u;\n+    t = ((u & 0x0F) << 3) + 0x84;\n+    t <<= (u >> 4) & 0x07;\n+    sample = (u & 0x80) ? (0x84 - t) : (t - 0x84);\n+    return (float)sample / 32768.0f;\n+}\n+\n+void fl_init(fl_t *f, float sr)\n+{\n+    int i;\n+    f->sr = sr;\n+    f->state = FL_OFF;\n+    f->nloops = 1;\n+    f->cur = 0;\n+    f->rec_cap = FL_CAP;\n+    f->rec_pos = 0;\n+    f->page_len = 0;\n+    f->wphase = 0;\n+    f->wlp = 0.0f;\n+    f->erase_next = FL_BASE;\n+    f->play_idx = 0;\n+    f->playing = 0;\n+    f->oneshot = 0;\n+    for (i = 0; i < 16; i++) f->gate[i] = FL_GATE_PASS;\n+    f->pitch = 0.0f;\n+    f->rpos = 0.0;\n+    f->rdir = 1;\n+    f->rpage = 0xFFFFFFFFu;\n+    f->rpage2 = 0xFFFFFFFFu;\n+    f->rvalid = 0;\n+    f->rvalid2 = 0;\n+    f->ramp = 0.0f;\n+    f->hp = 0.0f;\n+    f->len_bytes[0] = 0;\n+    f->len_bytes[1] = 0;\n+    f->base_bytes[0] = 0;\n+    f->base_bytes[1] = 0;\n+}\n+\n+/* base flash (adresse absolue) de la boucle idx : après tout ce que les boucles\n+ * précédentes ont physiquement écrit (dépassement du quantize inclus), jamais\n+ * un chevauchement de pages déjà programmées */\n+static uint32_t fl_base(int idx, const fl_t *f)\n+{\n+    return FL_AUD + f->base_bytes[idx];\n+}\n+\n+int fl_rec_arm(fl_t *f, int nloops)\n+{\n+    if (f->state != FL_OFF) return FL_ERR_STATE;\n+    if (nloops < 1) nloops = 1;\n+    if (nloops > FL_NLOOP_MAX) nloops = FL_NLOOP_MAX;\n+    f->nloops = nloops;\n+    f->cur = 0;\n+    f->rec_pos = 0;\n+    f->page_len = 0;\n+    f->rec_cap = FL_CAP / (uint32_t)nloops;\n+    if (f->rec_cap & (FL_PAGE - 1)) f->rec_cap &= ~(FL_PAGE - 1);\n+    f->erase_next = FL_BASE;\n+    f->state = FL_ERASE;\n+    return FL_OK;\n+}\n+\n+int fl_erase_step(fl_t *f)\n+{\n+    if (f->state != FL_ERASE) return FL_ERR_STATE;\n+    if (f->erase_next >= FL_END) {\n+        uint32_t i;\n+        for (i = 0; i < FL_PAGE; i++) f->page[i] = 0xFF;   /* octets 8..15 restent effacés */\n+        f->page[0] = 'F'; f->page[1] = 'L'; f->page[2] = '2'; f->page[3] = '5';\n+        f->page[4] = (uint8_t)f->nloops;\n+        f->page[5] = 0; f->page[6] = 0; f->page[7] = 0;\n+        if (fl_plat_write(FL_BASE, f->page) != 0) return FL_ERR_DATA;\n+        f->state = FL_ARMED;\n+        return FL_OK;                       /* effacement terminé : prêt à enregistrer */\n+    }\n+    if (fl_plat_erase(f->erase_next) != 0) return FL_ERR_ZONE;\n+    f->erase_next += FL_SECTOR;\n+    return FL_BUSY;\n+}\n+\n+int fl_rec_begin(fl_t *f)\n+{\n+    if (f->state != FL_ARMED) return FL_ERR_STATE;\n+    f->state = FL_REC;\n+    f->cur = 0;\n+    f->rec_pos = 0;\n+    f->page_len = 0;\n+    f->wphase = 0;\n+    f->wlp = 0.0f;\n+    return FL_OK;\n+}\n+\n+/* une page pleine part en flash ; retour 0 ok, FL_ERR_FULL quand la zone est pleine */\n+static int fl_page_commit(fl_t *f)\n+{\n+    uint32_t off = f->base_bytes[f->cur] + f->rec_pos;\n+    if (off + FL_PAGE > FL_CAP) return FL_ERR_FULL;   /* borne absolue de la zone */\n+    if (fl_plat_write(FL_AUD + off, f->page) != 0) return FL_ERR_DATA;\n+    f->rec_pos += FL_PAGE;\n+    f->page_len = 0;\n+    return FL_OK;\n+}\n+\n+int fl_rec_feed(fl_t *f, const float *bus, uint32_t n)\n+{\n+    uint32_t i;\n+    uint32_t inc = (uint32_t)((FL_RATE * 65536.0f) / f->sr);\n+    if (f->state != FL_REC) return FL_ERR_STATE;\n+    for (i = 0; i < n; i++) {\n+        float x = bus[i];\n+        if (x > 1.0f) x = 1.0f;\n+        if (x < -1.0f) x = -1.0f;\n+        f->wlp += (x - f->wlp) * 0.25f;         /* passe-bas léger avant la décimation */\n+        f->wphase += inc;\n+        if (f->wphase >= 65536u) {\n+            f->wphase -= 65536u;\n+            f->page[f->page_len++] = fl_ulaw_enc(f->wlp);\n+            if (f->page_len == FL_PAGE) {\n+                int r = fl_page_commit(f);\n+                if (r == FL_ERR_FULL) { fl_rec_end(f, 0.0f); return FL_OK; }\n+                if (r != FL_OK) return r;\n+            }\n+        }\n+    }\n+    return FL_OK;\n+}\n+\n+/* quantifie aux beats : la plus grande longueur on-beat (table ml_quantize\n+ * 1..128 beats) qui tient dans la capture, sinon capture brute page-alignée */\n+static uint32_t fl_quant_bytes(uint32_t bytes, float bpm, uint32_t cap)\n+{\n+    static const uint32_t P[8] = { 16, 32, 64, 128, 256, 512, 1024, 2048 };\n+    float spb64;                              /* durée d'un 1/16 de note */\n+    uint32_t best = 0, k;\n+    int i;\n+    if (bpm < 20.0f) bpm = 120.0f;\n+    spb64 = (60.0f / bpm) / 4.0f;\n+    for (i = 7; i >= 0; i--) {\n+        k = (uint32_t)((float)P[i] * spb64 * FL_RATE) & ~(FL_PAGE - 1);\n+        if (k <= bytes) { best = k; break; }\n+    }\n+    if (best == 0) best = bytes & ~(FL_PAGE - 1);\n+    if (best > cap) best = cap;\n+    return best;\n+}\n+\n+int fl_rec_end(fl_t *f, float bpm)\n+{\n+    if (f->state != FL_REC) return FL_ERR_STATE;\n+    if (f->page_len > 0) {                      /* page partielle : pad puis écriture */\n+        uint32_t i;\n+        for (i = f->page_len; i < FL_PAGE; i++) f->page[i] = f->page[f->page_len - 1];\n+        f->page[f->page_len - 1] = f->page[0];  /* le pad = dernier octet, boucle souple */\n+        f->page_len = FL_PAGE;\n+        (void)fl_page_commit(f);\n+    }\n+    f->len_bytes[f->cur] = (bpm > 0.0f) ? fl_quant_bytes(f->rec_pos, bpm, f->rec_cap) : (f->rec_pos & ~(FL_PAGE - 1));\n+    if (f->cur + 1 < f->nloops)                 /* base de la suivante : après tout l'écrit */\n+        f->base_bytes[f->cur + 1] = f->base_bytes[f->cur] + ((f->rec_pos + FL_PAGE - 1) / FL_PAGE) * FL_PAGE;\n+    f->cur++;\n+    if (f->cur < f->nloops) {\n+        f->rec_pos = 0;\n+        f->page_len = 0;\n+        return FL_BUSY;                        /* prêt pour la boucle suivante */\n+    }\n+    /* écrit les longueurs dans le header (copie RAM conservée) */\n+    {   uint32_t i, b;\n+        for (i = 0; i < FL_PAGE; i++) f->page[i] = 0;\n+        f->page[0] = 'F'; f->page[1] = 'L'; f->page[2] = '2'; f->page[3] = '5';\n+        f->page[4] = (uint8_t)f->nloops;\n+        b = f->len_bytes[0];\n+        f->page[8] = (uint8_t)(b >> 24); f->page[9] = (uint8_t)(b >> 16);\n+        f->page[10] = (uint8_t)(b >> 8); f->page[11] = (uint8_t)b;\n+        b = f->len_bytes[1];\n+        f->page[12] = (uint8_t)(b >> 24); f->page[13] = (uint8_t)(b >> 16);\n+        f->page[14] = (uint8_t)(b >> 8); f->page[15] = (uint8_t)b;\n+        (void)fl_plat_write(FL_BASE, f->page);\n+    }\n+    f->state = FL_OFF;\n+    return FL_OK;\n+}\n+\n+int fl_play(fl_t *f, int idx)\n+{\n+    if (f->state != FL_OFF || idx < 0 || idx >= f->nloops) return FL_ERR_STATE;\n+    if (f->len_bytes[idx] == 0) return FL_ERR_DATA;\n+    f->play_idx = idx;\n+    f->state = FL_PLAY;\n+    f->playing = 1;\n+    f->rpos = 0.0;\n+    f->rdir = 1;\n+    f->rpage = 0xFFFFFFFFu;\n+    f->rpage2 = 0xFFFFFFFFu;\n+    f->rvalid = 0;\n+    f->rvalid2 = 0;\n+    f->ramp = 0.0f;\n+    return FL_OK;\n+}\n+\n+void fl_stop(fl_t *f)\n+{\n+    if (f->state == FL_PLAY) { f->state = FL_OFF; f->playing = 0; }\n+}\n+\n+void fl_set_oneshot(fl_t *f, int on) { f->oneshot = on ? 1 : 0; }\n+int  fl_get_oneshot(const fl_t *f) { return f->oneshot; }\n+void fl_set_pitch(fl_t *f, float semis)\n+{\n+    if (semis < -12.0f) semis = -12.0f;\n+    if (semis > 12.0f) semis = 12.0f;\n+    f->pitch = semis;\n+}\n+void fl_set_gate(fl_t *f, int step, int g)\n+{\n+    if (step < 0 || step > 15) return;\n+    if (g < FL_GATE_PASS) g = FL_GATE_PASS;\n+    if (g > FL_GATE_REV) g = FL_GATE_REV;\n+    f->gate[step] = (uint8_t)g;\n+}\n+\n+/* échantillon brut à idx ; streaming par pages (double-tampon : courant + précédent) */\n+static uint8_t fl_read_byte(fl_t *f, uint32_t idx)\n+{\n+    uint32_t len = f->len_bytes[f->play_idx];\n+    uint32_t pg, off, i;\n+    if (len == 0) return 0;\n+    if (idx >= len) idx = len - 1;              /* clamp au dernier octet */\n+    pg = idx >> 8;\n+    off = idx & (FL_PAGE - 1);\n+    if (f->rvalid && (f->rpage >> 8) == pg) return f->rbuf[off];\n+    if (f->rvalid2 && (f->rpage2 >> 8) == pg) return f->rbuf2[off];\n+    /* page absente : le tampon courant devient le précédent, on charge la page demandée */\n+    for (i = 0; i < FL_PAGE; i++) f->rbuf2[i] = f->rbuf[i];\n+    f->rpage2 = f->rpage;\n+    f->rvalid2 = f->rvalid;\n+    if (fl_plat_read(fl_base(f->play_idx, f) + (pg << 8), f->rbuf, FL_PAGE) != 0) return 0;\n+    f->rpage = pg << 8;\n+    f->rvalid = 1;\n+    return f->rbuf[off];\n+}\n+\n+static float fl_sample(fl_t *f, double pos)\n+{\n+    uint32_t len = f->len_bytes[f->play_idx];\n+    float a, b, fr;\n+    uint32_t i0, i1;\n+    if (len < 2) return 0.0f;\n+    if (pos < 0.0) pos += (double)len;\n+    if (pos >= (double)len) pos -= (double)len;\n+    i0 = (uint32_t)pos;\n+    i1 = (i0 + 1 < len) ? i0 + 1 : i0;\n+    a = fl_ulaw_dec(fl_read_byte(f, i0));\n+    b = fl_ulaw_dec(fl_read_byte(f, i1));\n+    fr = (float)(pos - (double)i0);\n+    return a + (b - a) * fr;\n+}\n+\n+int fl_render(fl_t *f, float *out, uint32_t n, float bus_clk64)\n+{\n+    uint32_t i;\n+    float rate = FL_RATE / f->sr;\n+    float pitch = 1.0f;\n+    int st, last_gate = -1;\n+    if (f->state != FL_PLAY) return f->state;\n+    /* pitch ±12 st : entiers par multiplication (1.0594631), fraction linéaire */\n+    st = (int)f->pitch;\n+    pitch = 1.0f + (f->pitch - (float)st) * 0.0594631f;\n+    for (; st > 0; st--) pitch *= 1.0594631f;\n+    for (; st < 0; st++) pitch *= 0.9438745f;\n+    for (i = 0; i < n; i++) {\n+        uint32_t step = ((uint32_t)bus_clk64 >> 2) & 15u;   /* 16 steps de 1/16 de note */\n+        int g = f->gate[step];\n+        float x;\n+        if (g != last_gate) { f->ramp = 0.0f; last_gate = g; }\n+        f->ramp += 1.0f / 256.0f;\n+        if (f->ramp > 1.0f) f->ramp = 1.0f;\n+        if (g == FL_GATE_MUTE) {                    /* figée, muette (déclick en sortie) */\n+            x = 0.0f;\n+        } else {\n+            double len = (double)f->len_bytes[f->play_idx];\n+            int dir = (g == FL_GATE_REV) ? -1 : f->rdir;   /* REV = marche arrière du step */\n+            f->rpos += (double)(pitch * rate) * (double)dir;\n+            if (f->rpos >= len) {\n+                if (f->oneshot) { f->state = FL_ONESHOT_STOP; f->playing = 0; return f->state; }\n+                f->rpos -= len;\n+                f->rpage = 0xFFFFFFFFu; f->rpage2 = 0xFFFFFFFFu; f->rvalid = 0; f->rvalid2 = 0;\n+            }\n+            if (f->rpos < 0.0) {\n+                if (f->oneshot) { f->state = FL_ONESHOT_STOP; f->playing = 0; return f->state; }\n+                f->rpos += len;\n+                f->rpage = 0xFFFFFFFFu; f->rpage2 = 0xFFFFFFFFu; f->rvalid = 0; f->rvalid2 = 0;\n+            }\n+            x = fl_sample(f, f->rpos);\n+            f->hp += (x - f->hp) * 0.02f;          /* coupe-bas doux (rumble du ring) */\n+            x -= f->hp;\n+        }\n+        out[i] += x * f->ramp * 0.9f;\n+    }\n+    return f->state;\n+}\n","file_size_bytes":16824,"returned_bytes":16824,"offset":0,"lines_read":433,"was_truncated":false,"total_lines":433,"next_offset":null}