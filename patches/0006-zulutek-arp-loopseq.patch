                     ml_fire(m, i, s, 0.0f, p1, 1);
                 } else ml_fire(m, i, s, p0, p1, -1);
             }
+        } else if (s->sp.mode == 3) {                          /* RANDOM (pack SEQ+) : saut aléatoire au wrap */
+            p1 = p0 + step;
+            if (p1 >= (float)s->len) {
