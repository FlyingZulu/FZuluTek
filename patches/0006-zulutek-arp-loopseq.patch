         } else {                                               /* normal */
             p1 = p0 + step;
-            if (p1 >= (float)s->len) { ml_fire(m, i, s, p0, (float)s->len, 1); p1 -= (float)s->len; ml_fire(m, i, s, 0.0f, p1, 1); }
