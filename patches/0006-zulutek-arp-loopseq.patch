+                p1 -= (float)s->len;
+                if (m->randp > 0.0f && (float)(ml_rnd(m) & 0xFFFF) / 65536.0f < m->randp)
+                    ml_rand_slot(m, i);                        /* RAND au wrap (mode normal aussi) */
+                ml_fire(m, i, s, 0.0f, p1, 1);
