diff --git a/atek303/app/ztek_arp.c b/atek303/app/ztek_arp.c
new file mode 100644
index 0000000..a0b5496
--- /dev/null
+++ b/atek303/app/ztek_arp.c
@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (C) 2026 FlyingZulu
+ *
+ * ztek_arp.c — see ztek_arp.h. C99, no dynamic allocation (FM-1), per-chunk render. */
+#include "ztek_arp.h"
+
+#define ZARP_NHELD 16
+#define ZARP_NMODE 5
+#define ZARP_NDIV  6
+
+static const float SPB[ZARP_NDIV] = { 1.f, 2.f, 4.f, 8.f, 3.f, 6.f };  /* steps per beat */
+
+static int     s_on;
+static float   s_k[4];                    /* MODE OCT DIV GATE */
+static int     s_held[ZARP_NHELD];        /* sorted ascending */
+static int     s_order[ZARP_NHELD];       /* as-played */
+static int     s_n, s_nord, s_idx;
+static float   s_clk;
+static int     s_note;                    /* -1 none */
+static int32_t s_gate;                    /* samples left before note-off */
+static uint32_t s_rng;
+static float   s_sr;
+
+static uint32_t zarp_rnd(void)
+{
+    s_rng = s_rng * 1664525u + 1013904223u;
+    return s_rng >> 8;
+}
+
+static int zarp_mode(void)
+{
+    int m = (int)(s_k[0] * (ZARP_NMODE - 0.01f));
+    return m < 0 ? 0 : m >= ZARP_NMODE ? ZARP_NMODE - 1 : m;
+}
+static int zarp_oct(void)
+{
+    int o = 1 + (int)(s_k[1] * 3.99f);
+    return o < 1 ? 1 : o > 4 ? 4 : o;
+}
+static int zarp_div(void)
+{
+    int d = (int)(s_k[2] * (ZARP_NDIV - 0.01f));
+    return d < 0 ? 0 : d >= ZARP_NDIV ? ZARP_NDIV - 1 : d;
+}
+
+static void zarp_silence(void)
+{
+    if (s_note >= 0) {
+        zarp_gate(0, s_note, 0, 0);
+        s_note = -1;
+    }
+    s_gate = 0;
+}
+
+static void zarp_step(void)
+{
+    int mode = zarp_mode(), oct = zarp_oct(), div = zarp_div();
+    const int *base = (mode == 4) ? s_order : s_held;
+    int base_n = (mode == 4) ? s_nord : s_n;
+    int L, idx, note;
+    if (base_n <= 0) return;
+    L = base_n * oct;
+    switch (mode) {
+    case 1:  idx = L - 1 - (s_idx % L); break;                   /* DOWN */
+    case 2: { int p = s_idx % (2 * L - 2);                       /* UP-DOWN */
+              idx = p < L ? p : 2 * L - 2 - p; break; }
+    case 3:  idx = (int)(zarp_rnd() % (uint32_t)L); break;        /* RANDOM */
+    default: idx = s_idx % L; break;                             /* UP / AS-PLAYED */
+    }
+    s_idx++;
+    note = base[idx % base_n] + 12 * (idx / base_n);
+    if (note < 0) note = 0;
+    if (note > 127) note = 127;
+    if (s_note >= 0 && s_note != note) zarp_silence();
+    zarp_gate(1, note, 0, 0);
+    s_note = note;
+    {
+        float gate = s_k[3] * 0.95f + 0.05f;
+        float step_s = s_sr / (((float)zarp_tempo() / 60.0f) * SPB[div]);
+        s_gate = (int32_t)(gate * step_s);
+    }
+}
+
+void zarp_init(float sr)
+{
+    s_on = 0;
+    s_k[0] = 0.0f; s_k[1] = 0.34f; s_k[2] = 0.4f; s_k[3] = 0.5f;   /* UP, 2 oct, 1/16, gate 50% */
+    s_n = s_nord = s_idx = 0;
+    s_clk = 0.0f;
+    s_note = -1;
+    s_gate = 0;
+    s_rng = 0x2545F491u;
+    s_sr = sr;
+}
+
+void zarp_set_on(int on)
+{
+    on = on ? 1 : 0;
+    if (s_on == on) return;
+    s_on = on;
+    if (!on) {
+        zarp_silence();
+        s_n = s_nord = 0;
+        s_clk = 0.0f;
+    } else {
+        s_idx = 0;
+        s_clk = 1.0f;                 /* start at the next chunk */
+    }
+}
+
+int zarp_on(void) { return s_on; }
+
+void zarp_knob(int k, float v)
+{
+    if (k < 0 || k > 3) return;
+    if (v < 0.0f) v = 0.0f;
+    if (v > 1.0f) v = 1.0f;
+    s_k[k] = v;
+}
+
+float zarp_knob_get(int k)
+{
+    if (k < 0 || k > 3) return 0.0f;
+    return s_k[k];
+}
+
+void zarp_knob_turn(int k, int32_t det)
+{
+    if (det == 0) return;
+    if (k == 0) {                                    /* MODE stepped */
+        int m = zarp_mode() + (det > 0 ? 1 : -1);
+        if (m < 0) m = ZARP_NMODE - 1;
+        if (m >= ZARP_NMODE) m = 0;
+        s_k[0] = ((float)m + 0.5f) / ZARP_NMODE;
+    } else if (k == 1) {                             /* OCT 1..4 */
+        int o = zarp_oct() + (det > 0 ? 1 : -1);
+        if (o < 1) o = 4;
+        if (o > 4) o = 1;
+        s_k[1] = (float)(o - 1) / 3.0f;
+    } else if (k == 2) {                             /* DIV 0..5 */
+        int d = zarp_div() + (det > 0 ? 1 : -1);
+        if (d < 0) d = ZARP_NDIV - 1;
+        if (d >= ZARP_NDIV) d = 0;
+        s_k[2] = (float)d / (ZARP_NDIV - 1);
+    } else {                                         /* GATE 0.05..1.0 by 5% */
+        float g = s_k[3] + (det > 0 ? 0.05f : -0.05f);
+        if (g < 0.05f) g = 1.0f;
+        if (g > 1.0f) g = 0.05f;
+        s_k[3] = g;
+    }
+}
+
+void zarp_cycle_mode(int dir) { zarp_knob_turn(0, dir > 0 ? 1 : -1); }
+
+void zarp_note_in(int note)
+{
+    int i;
+    if (note < 0 || note > 127) return;
+    for (i = 0; i < s_n; i++) if (s_held[i] == note) return;   /* already held */
+    if (s_n == 0) s_idx = 0;
+    if (s_n < ZARP_NHELD) {
+        i = s_n;
+        while (i > 0 && s_held[i - 1] > note) { s_held[i] = s_held[i - 1]; i--; }
+        s_held[i] = note;
+        s_n++;
+    }
+    if (s_nord < ZARP_NHELD) s_order[s_nord++] = note;
+}
+
+void zarp_note_out(int note)
+{
+    int i, j;
+    for (i = 0; i < s_n; i++) if (s_held[i] == note) {
+        for (j = i; j < s_n - 1; j++) s_held[j] = s_held[j + 1];
+        s_n--;
+        break;
+    }
+    for (i = 0; i < s_nord; i++) if (s_order[i] == note) {
+        for (j = i; j < s_nord - 1; j++) s_order[j] = s_order[j + 1];
+        s_nord--;
+        break;
+    }
+    if (s_n == 0) zarp_silence();                    /* nothing held: silence */
+}
+
+void zarp_clear(void)
+{
+    zarp_silence();
+    s_n = s_nord = 0;
+}
+
+int zarp_held(void) { return s_n; }
+
+void zarp_render(uint32_t n, float dt)
+{
+    uint32_t i;
+    float rate;
+    if (!s_on) return;
+    rate = ((float)zarp_tempo() / 60.0f) * SPB[zarp_div()] / s_sr;   /* steps per sample */
+    for (i = 0; i < n; i++) {
+        if (s_gate > 0 && --s_gate == 0 && s_note >= 0) zarp_silence();
+        s_clk += rate;
+        while (s_clk >= 1.0f) {
+            s_clk -= 1.0f;
+            zarp_step();
+        }
+    }
+    (void)dt;
+}
